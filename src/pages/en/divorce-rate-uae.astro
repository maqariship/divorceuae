  { year: '2016', cases: '2,170', expat: '1,313', crude: '3.76' },
  { year: '2017', cases: '2,160', expat: '1,279', crude: '3.68' },
  { year: '2018', cases: '2,029', expat: '1,362', crude: '2.67' },
