---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Emergency Court Orders in a UAE Divorce: Custody, Travel, Money';
const description =
  'Urgent orders in a UAE divorce: temporary alimony, custody, child travel bans, passports, asset seizure and domestic violence protection, and the law behind each.';

const hreflang = {
  en: 'https://divorceu.ae/en/emergency-orders-divorce-uae/',
  ar: 'https://divorceu.ae/ar/أوامر-الطوارئ-الطلاق-الامارات/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Emergency Orders Divorce UAE', url: 'https://divorceu.ae/en/emergency-orders-divorce-uae/' },
];

const summaryCards = [
  { label: 'Family Guidance first?', value: 'Not required', note: 'Urgent and temporary orders are exempt (Art. 8, Decree-Law 41/2024)' },
  { label: 'Temporary alimony', value: 'Enforceable at once', note: 'Muslim track, Art. 100; non-Muslims, Art. 10 of Cabinet Res. 122/2023' },
  { label: 'Child travel abroad', value: 'Consent or permit', note: 'Art. 116; court-permitted trips up to 60 days a year in total' },
];

const orderTypes = [
  { icon: '👶', title: 'Temporary custody and visitation order', desc: 'Settles where the children live and when the other parent sees them until the dispute is decided. For Muslims, urgent and temporary custody orders are not sent to Family Guidance first (Art. 8 of Federal Decree-Law No. 41 of 2024). At the Abu Dhabi Civil Family Court a judge can temporarily suspend joint custody or set temporary visitation (Art. 42 of the 2022 Regulation).' },
  { icon: '✈️', title: 'Child travel ban', desc: 'Stops a child being taken abroad while a dispute runs. For non-Muslims, either parent can apply after the divorce to stop the child travelling for a temporary period (Art. 22 of Cabinet Resolution No. 122 of 2023). For Muslims, travel abroad already needs the other parent’s written approval or a court permit (Art. 116).' },
  { icon: '🛂', title: 'Passport and documents order', desc: 'The guardian normally keeps the child’s passport and hands it over for travel; the court can order it kept by the custodian if the guardian obstinately refuses to hand it over when needed (Art. 117). The custodian keeps the child’s ID documents but may not use them for travel without the guardian’s or the court’s permit (Art. 124).' },
  { icon: '🏦', title: 'Protective seizure of assets', desc: 'Asks the court to freeze money or property so it cannot be moved before a money claim is decided. Abu Dhabi’s civil regulation lists imposing or cancelling a protective seizure as a provisional order (Art. 42); in the other courts a precautionary attachment is requested under the Civil Procedure Code.' },
  { icon: '🛡️', title: 'Protection order (domestic violence)', desc: 'Available under Federal Decree-Law No. 13 of 2024 on Protection from Domestic Violence, from the Public Prosecution or a court. Separate from the divorce case. Restrains contact and approaching the victim’s home, work or other set places.' },
  { icon: '📋', title: 'Temporary maintenance order', desc: 'For Muslims, the court can order temporary maintenance for the wife and children while her maintenance case is heard, enforceable immediately by force of law (Art. 100). For non-Muslims it is requested after the divorce judgment and decided by an order on a petition (Art. 10 of Cabinet Resolution No. 122 of 2023).' },
];

const urgencyApplicationSteps = [
  { n: 1, title: 'Document the evidence', body: 'Before calling a lawyer, gather everything that shows the risk or urgency: photographs, medical reports, police reports, messages showing threats or plans to leave, bank statements showing money transfers abroad, school records and witness contact details. Courts need specific, documented evidence of a risk, not general relationship breakdown.' },
  { n: 2, title: 'Get representation quickly', body: 'An urgent request is a written application in Arabic (English is possible at the Abu Dhabi Civil Family Court) setting out the facts and the order you want, with your evidence attached. You may file yourself, authorise your spouse, an in-law or a blood relative up to the fourth degree to appear for you, or instruct a lawyer licensed in the UAE (Arts. 6 and 8 of Federal Decree-Law No. 34 of 2022).' },
  { n: 3, title: 'File with the right court', body: 'Where the law requires court permission, the request is made by an order on petition to the court where you live (Art. 6 of Federal Decree-Law No. 41 of 2024). Claims by a wife, child or custodian on alimony, custody or visitation can be filed where either party lives or works or where the marital home is (Art. 3). Fees depend on the emirate and the order: in Abu Dhabi the ADJD lists AED 100 for a Personal Status interim order, with alimony requests free, and AED 400 for a travel ban.' },
  { n: 4, title: 'The judge decides on the papers', body: 'The judge decides on the request and the documents filed and may investigate or ask for more documents first (Art. 6). No federal law sets a general deadline. In Abu Dhabi, the ADJD says the judge issues an interim order by the next working day after the application is submitted.' },
  { n: 5, title: 'Make sure the order is applied', body: 'A temporary maintenance decision under Art. 100 is enforceable immediately. For a travel ban or a seizure, ask your lawyer to confirm the order has actually reached the authorities that must apply it, rather than assuming it is active.' },
  { n: 6, title: 'Expect a challenge', body: 'Any interested party may appeal an order on petition within one week (Art. 6). At the Abu Dhabi Civil Family Court either spouse can object to a temporary alimony decision under the usual rules for interim orders (Art. 22 of the 2022 Regulation). Keep your evidence ready to defend the order.' },
];

const evidenceTypes = [
  { type: 'For an urgent custody order or child removal risk', items: ['Messages or emails discussing travel plans or threats to take the children', 'Evidence of one-way flight bookings', 'School withdrawal letters or requests for school records', 'Where the children’s passports are, if you know', 'History of threats to leave the UAE with the children', 'Previous unauthorised travel attempts'] },
  { type: 'For a protective seizure', items: ['Bank statements showing large transfers abroad', 'Evidence of a property listed for a quick sale', 'Business asset transfers to third parties', 'Evidence of cryptocurrency or cash movements', 'Messages about hiding money from the proceedings', 'Sudden lifestyle changes inconsistent with declared income'] },
  { type: 'For a protection order (domestic violence)', items: ['Police reports or hospital records', 'Photographs of injuries', 'Statements from neighbours or family members who witnessed incidents', 'Medical certificates', 'Records of previous police call-outs', 'Messages containing threats or abuse'] },
];

const faqItems = [
  {
    question: 'Can I get an emergency custody order without a lawyer?',
    answer: 'Yes, you may file in person (Art. 52 of the Civil Procedure Code, Federal Decree-Law No. 42 of 2022), or authorise your spouse, an in-law or a blood relative up to the fourth degree to appear for you. In practice it is hard, because the request must set out the facts and the legal basis clearly and, outside the Abu Dhabi Civil Family Court, be in Arabic. A delay in an emergency can mean children leave the country or money disappears, so if cost is the obstacle, ask a lawyer for a fixed fee for the urgent application alone.',
  },
  {
    question: 'Do I have to go through Family Guidance before asking for an urgent order?',
    answer: 'No. Article 8 of Federal Decree-Law No. 41 of 2024 exempts urgent and temporary cases, and urgent or temporary orders on alimony, custody and guardianship, from referral to Family Guidance. Non-Muslim civil divorces under Federal Decree-Law No. 41 of 2022 are not referred to Family Guidance at all (Art. 3).',
  },
  {
    question: 'What evidence do I need for an emergency custody order?',
    answer: 'The court needs to see a credible, specific risk to the child, not just a difficult co-parenting situation. Useful evidence includes photographs, medical reports showing injuries or neglect, police reports, messages showing threats or plans to take the children abroad, one-way flight bookings, school withdrawal requests and witness statements. General allegations without documents rarely support an urgent order.',
  },
  {
    question: 'Can my spouse cancel the travel ban placed on our children?',
    answer: 'Only through the court. Your spouse has to apply to the court to lift or vary it, and you can oppose the application; an order on petition can also be appealed within one week (Art. 6 of Federal Decree-Law No. 41 of 2024). In Abu Dhabi, the ADJD says an interim travel ban continues until a party applies to the court to remove it. Courts can allow a specific trip with a guarantee that the child returns (Art. 116 for Muslims; Art. 21 of Cabinet Resolution No. 122 of 2023 for non-Muslims).',
  },
  {
    question: 'What if my spouse has already left the UAE with the children?',
    answer: 'Act immediately. Contact a lawyer and report the removal to the police. The UAE is not a party to the 1980 Hague Child Abduction Convention, so there is no treaty process to order the child’s return; recovery depends on the courts and law of the country the child was taken to. Inside the UAE, a custodian who travels with the child without the guardian’s or the court’s permission commits an offence punishable by imprisonment and/or a fine of AED 5,000 to AED 50,000 (Art. 252), prosecuted only on a complaint by the person concerned (Art. 255). See our international child abduction guide.',
  },
  {
    question: 'How long does a protective seizure of assets last?',
    answer: 'Until the court lifts it or the main claim is decided, and the person whose assets are seized can ask the court to cancel it. A seizure protects a claim that still has to be pursued: in Abu Dhabi, the ADJD says an urgent request made before the main case requires you to commit to filing the main case within 8 days. The assets are not lost; they are held in place pending the outcome.',
  },
  {
    question: 'Will an emergency order affect my divorce outcome?',
    answer: 'Emergency orders are temporary and do not decide the final result. However, the evidence used to obtain them, and how each parent behaves while they are in force, can influence how the judge sees both parties later. Apply only where there are genuine, documented grounds; an order obtained without real grounds can reflect badly on the applicant.',
  },
  {
    question: 'How fast can a domestic violence protection order be issued?',
    answer: 'Under Federal Decree-Law No. 13 of 2024 on Protection from Domestic Violence, the Public Prosecution can issue a restraining order without waiting for a court trial. Published summaries of the law say a prosecution order lasts up to 30 days and can be extended for two further periods of the same length, after which the competent court can extend it for up to six months or until the judgment becomes final. If you are in immediate danger, go to the nearest police station or call the police first.',
  },
  {
    question: 'Can I get urgent maintenance before the divorce is finished?',
    answer: 'Yes, in the Muslim track. Article 100 of Federal Decree-Law No. 41 of 2024 lets the court, at the wife’s request, order temporary maintenance for her and the children while her maintenance case is heard, enforceable immediately. For non-Muslims under the 2022 civil law, temporary alimony is requested after the divorce judgment, until the financial rights are decided (Art. 10 of Cabinet Resolution No. 122 of 2023). See our temporary alimony guide for the full procedure.',
  },
  {
    question: 'Does a UAE travel ban still work if the other country is not in the Hague Convention?',
    answer: 'This is exactly why a preventative travel ban matters. The UAE is not a party to the 1980 Hague Convention on the Civil Aspects of International Child Abduction, so if a child is removed abroad there is no treaty mechanism to order the child returned. Return then depends on the destination country’s courts and law, which is slow and uncertain. Stopping the removal before it happens is far more reliable than trying to recover a child afterwards.',
  },
  {
    question: 'How quickly can I get an asset seizure if my spouse is moving money abroad?',
    answer: 'There is no fixed national deadline, and courts decide urgent requests on the papers you file. In Abu Dhabi, the ADJD says interim orders are issued by the next working day after the application. You will need concrete evidence of the risk, such as statements showing large outbound transfers or a property newly listed for a quick sale. Speed matters: once funds leave the UAE, freezing them needs separate proceedings in the country they were sent to.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://divorceu.ae/en/emergency-orders-divorce-uae/"
  {hreflang}
  lang="en"
  lastmod="2026-10-12"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">Emergency Orders · UAE Divorce 2026</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        When a separation turns urgent, you do not have to wait for the divorce judgment. UAE courts can make temporary orders on maintenance, custody, child travel and passports, and freeze assets, and the Public Prosecution can issue domestic violence restraining orders. This guide explains each order, the law behind it, the evidence courts look for and how to apply.
      </p>
      <div class="hero-meta">
        <span>Updated: October 2026</span>
        <span class="sep">·</span>
        <span>By Aleksi Suon, UAE Expat &amp; Legal Consultant</span>
      </div>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="summary-box">
        <h2>Key facts at a glance</h2>
        <div class="summary-grid">
          {summaryCards.map((card) => (
            <div class="summary-card">
              <p class="summary-label">{card.label}</p>
              <p class="summary-value">{card.value}</p>
              <p class="summary-note">{card.note}</p>
            </div>
          ))}
        </div>
      </div>

      <section class="content-section">
        <h2>What Are Interim and Emergency Orders in UAE Divorce?</h2>
        <p>
          They are temporary court orders that protect a spouse, the children or the family's money while the main case is decided. Federal Decree-Law No. 41 of 2024, the personal status law for Muslims, treats them as a separate category: urgent and temporary cases, and urgent or temporary orders on alimony, custody and guardianship, are not referred to Family Guidance first (Article 8). Where the law requires the court's permission, you apply by an order on petition to the court where you live (Article 6).
        </p>
        <p>
          Non-Muslims have parallel tools. Under Cabinet Resolution No. 122 of 2023, the executive regulation of Federal Decree-Law No. 41 of 2022, a divorced wife can ask for temporary alimony (Article 10), a parent can ask the judge to allow or refuse a child's trip abroad during joint custody (Article 21), and either parent can ask the court to stop the child travelling for a temporary period after the divorce (Article 22). In Abu Dhabi, Article 42 of the 2022 Regulation under Abu Dhabi Law No. 14 of 2021 lists the provisional orders the Civil Family Court can make, from temporary alimony and housing to a child travel ban and a protective seizure.
        </p>
        <p>
          No federal law sets a general deadline for deciding these requests, and every order is temporary: it lasts until the court lifts or replaces it, or until the final judgment. The main types are:
        </p>
        <div class="orders-grid">
          {orderTypes.map((order) => (
            <div class="order-card">
              <div class="order-icon">{order.icon}</div>
              <div class="order-content">
                <h3>{order.title}</h3>
                <p>{order.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="content-section">
        <h2>Emergency Custody Orders: Protecting Your Children</h2>
        <p>
          An urgent custody order settles where the children live, or limits the other parent's time with them, until the court can decide the dispute properly. Courts act on documented risk: violence or abuse against the child, serious neglect, addiction affecting care, or a genuine threat to take the child out of the UAE. General parenting disagreements are dealt with in the ordinary case.
        </p>
        <p>
          The legal test depends on your track. For Muslims, custody after separation goes first to the mother, then the father and then the grandmothers, but the court may depart from that order in the child's interest (Article 114 of Federal Decree-Law No. 41 of 2024), and a custodian who no longer meets the conditions in Article 113, for example because of addiction or a dangerous disease, can lose custody (Article 115). For non-Muslims under Federal Decree-Law No. 41 of 2022, custody is joint and either parent can ask the court to decide a disputed custody issue in the child's best interest (Article 10). At the Abu Dhabi Civil Family Court, the judge can temporarily suspend joint custody while a request to remove a parent is decided (Article 32 of the 2022 Regulation), and a risk of domestic violence or abuse is a listed ground for removal (Article 33).
        </p>
        <h3>Interim custody while the divorce is running</h3>
        <p>
          Most custody disputes do not start as same-day emergencies. They start as a practical question: who do the children live with, and when does the other parent see them, while the divorce case works its way through the court? For this the court can make a temporary custody and visitation order that holds until the final judgment, after hearing both parents.
        </p>
        <p>
          Under Federal Decree-Law No. 41 of 2024, custody now continues to age 18 for boys and girls (Article 123), and at 15 a child may choose which parent to live with unless the child's interest requires otherwise (Article 122). An interim order made early in the case tends to shape the status quo the final judge sees, so it is worth getting the arrangement right at the interim stage rather than treating it as a placeholder. If circumstances change during the case, for example a move within the UAE or a new school, you apply to vary the interim order rather than waiting for the final hearing. For how the court weighs custody and guardianship over the longer term, see our <a href="/en/child-custody-uae/">child custody in the UAE guide</a>.
        </p>
      </section>

      <section class="content-section">
        <h2>Protective Seizure: Stopping Money Being Moved</h2>
        <p>
          If you have evidence that your spouse is moving money out of the UAE, selling assets cheaply or otherwise draining property before a money claim is decided, you can ask the court to seize it as a protective measure. At the Abu Dhabi Civil Family Court, imposing or cancelling a protective seizure is one of the listed provisional orders (Article 42 of the 2022 Regulation), and a final judgment can also include a protective seizure or a travel ban to secure its enforcement (Article 48). In the other courts the request is made as a precautionary attachment under the Civil Procedure Code, Federal Decree-Law No. 42 of 2022.
        </p>
        <p>
          A seizure can target:
        </p>
        <ul class="checklist">
          <li>Bank accounts held in the UAE</li>
          <li>Real estate registered in the UAE</li>
          <li>Shares and business interests registered in the UAE</li>
          <li>Specific assets you can identify, such as vehicles or investments</li>
          <li>Money a third party, such as an employer, owes your spouse</li>
        </ul>
        <p>
          A seizure does not transfer ownership; it stops the asset being disposed of while the claim is decided. The person whose assets are seized can ask the court to lift or vary the order.
        </p>
        <div class="info-box info-box--warning">
          <h3>Cryptocurrency and overseas assets</h3>
          <p>A UAE order works on assets the UAE courts can reach. Freezing money or property abroad usually needs separate proceedings in the country where it is held. Mention any known overseas assets to your lawyer at the first consultation, because early action improves the chance of protecting them.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>Travel Bans in Divorce Cases</h2>
        <p>
          A court can stop a child, and in money disputes a spouse, from leaving the UAE. The rules for children differ by track.
        </p>
        <p>
          For Muslims, the custodial parent may travel abroad with the child only with the other parent's written approval (Article 116 of Federal Decree-Law No. 41 of 2024). Without it, the court may authorise trips totalling no more than 60 days a year, with a guarantee of the child's return, and longer if the trip is for the child's benefit, treatment or another necessity, after hearing the other parent. The guardian keeps the child's passport except when it is needed for travel (Article 117). Travelling with the child without the guardian's or the court's permission, or misusing the child's documents, is an offence punishable by imprisonment and/or a fine of AED 5,000 to AED 50,000 (Article 252), prosecuted only on a complaint by the person concerned and ended if that complaint is withdrawn before a final judgment (Article 255).
        </p>
        <p>
          For non-Muslims under Federal Decree-Law No. 41 of 2022, neither parent may take the child abroad by a unilateral decision during joint custody; if the other objects, the judge decides and can require guarantees of return (Article 21 of Cabinet Resolution No. 122 of 2023). After the divorce either parent can ask the court to stop the child travelling for a temporary period, stating the objection (Article 22). Abu Dhabi's Civil Family Court applies the same approach (Articles 37 and 38 of its 2022 Regulation). Our <a href="/en/child-travel-consent-uae/">child travel consent guide</a> covers the consent letter, the court permit and passports in detail.
        </p>
        <p>
          A travel ban on a spouse is usually tied to a money claim, such as unpaid maintenance, and is decided on its own facts. In Abu Dhabi, the ADJD lists a travel ban request at AED 400 and says an interim travel ban stays in place until a party applies to the court to remove it.
        </p>
        <h3>Why the travel ban matters more here: the Hague gap</h3>
        <p>
          A travel ban on a child is preventative for a reason specific to the UAE. The UAE is not a party to the 1980 Hague Convention on the Civil Aspects of International Child Abduction. In member states, a parent whose child is wrongfully taken abroad can use a treaty process to seek the child's return. That process is not available to or from the UAE, so recovering a child depends on the courts and law of the country the child was taken to, which is neither quick nor certain.
        </p>
        <p>
          The practical consequence is simple: stopping removal at the border is far more effective than trying to reverse it afterwards. If you are worried a removal is being planned, treat it as urgent and apply before any attempt is made, not after. Our guides on <a href="/en/travel-ban-divorce-uae/">travel bans during divorce</a> and <a href="/en/international-child-abduction-uae/">international child abduction from the UAE</a> set out both the preventative and the recovery routes in more detail.
        </p>
      </section>

      <section class="content-section">
        <h2>Domestic Violence Protection Orders</h2>
        <p>
          Protection orders are governed by <strong>Federal Decree-Law No. 13 of 2024 on Protection from Domestic Violence</strong>, which replaced the 2019 domestic violence law. A protection order is separate from divorce proceedings: you can seek one before, during or without any divorce case.
        </p>
        <p>
          According to published summaries of the law, a restraining order can require the respondent to:
        </p>
        <ul class="checklist">
          <li>Stop contacting the victim by any means, directly or through others</li>
          <li>Stay away from the victim's home, workplace, school or other places named in the order</li>
          <li>Not damage the victim's property or personal belongings</li>
          <li>Pay financial support and medical expenses</li>
          <li>Attend social or psychological counselling</li>
        </ul>
        <h3>How fast a protection order can be issued</h3>
        <p>
          The fastest route runs through the Public Prosecution rather than a civil filing, because the prosecution can issue a restraining order without waiting for a court trial. Published summaries of the 2024 law say a prosecution order lasts up to 30 days and can be extended for two further periods of the same length, after which the competent court can extend it for up to six months or until the judgment becomes final. Confirm the current periods with your lawyer against the official text.
        </p>
        <p>
          Breaching a restraining order is a criminal offence that can lead to imprisonment and a fine. In an immediate danger situation, go to the nearest police station or call the police first. For how protection orders interact with a divorce filing, custody and fault, see our guide on <a href="/en/domestic-violence-divorce-uae/">domestic violence and divorce in the UAE</a>.
        </p>
      </section>

      <section class="content-section">
        <h2>Emergency and Interim Maintenance Orders</h2>
        <p>
          A common trigger for urgent action is money rather than safety. When one spouse controls the household finances and cuts off support after separation, the other spouse and the children can be left without funds while the case runs. You do not have to wait for the final judgment to fix this.
        </p>
        <p>
          For Muslims, Article 100 of Federal Decree-Law No. 41 of 2024 lets the court, at the wife's request and during the hearings of her maintenance case, order temporary maintenance for her and the children from the respondent, and that decision is enforceable immediately by force of law. For non-Muslims under Federal Decree-Law No. 41 of 2022, the divorced wife can ask for temporary alimony after the divorce judgment until her financial rights are decided, with both spouses' monthly income and six months of account statements; the court decides by an order on a petition and may refuse if she has a job or fixed income covering her basic needs (Article 10 of Cabinet Resolution No. 122 of 2023). Abu Dhabi's Civil Family Court has the same rule (Article 21 of its 2022 Regulation) and can also order temporary housing or the reconnection of utilities (Article 42). Our guide to <a href="/en/temporary-alimony-uae/">temporary alimony in the UAE</a> sets out the forms and evidence for each court.
        </p>
        <p>
          The order is only as useful as its enforcement. If the spouse ignores it, you take it to the execution court, which can deduct from salary, attach bank accounts and, where justified, ban the debtor from travelling. In the Muslim track, maintenance due from the date the claim was filed is a privileged debt that ranks ahead of the payer's other debts (Article 98). For the step-by-step collection process, see our guide on <a href="/en/unpaid-alimony-enforcement-uae/">enforcing unpaid alimony in the UAE</a>.
        </p>
        <div class="info-box info-box--info">
          <h3>Keep proof of what stopped</h3>
          <p>Bank records showing regular transfers that suddenly ended, unpaid school or rent invoices, and messages where support was refused all help the court set a temporary figure. Bring these to the first consultation rather than reconstructing them later.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>How to Apply for an Urgent Order, Step by Step</h2>
        <div class="step-list">
          {urgencyApplicationSteps.map((step) => (
            <div class="step-item">
              <div class="step-num">{step.n}</div>
              <div class="step-content">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </div>
          ))}
        </div>
        <h3>Evidence by order type</h3>
        <div class="evidence-list">
          {evidenceTypes.map((ev) => (
            <div class="evidence-card">
              <h3>{ev.type}</h3>
              <ul class="compact-list">
                {ev.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="content-section">
        <h2>After You Get the Emergency Order: Next Steps</h2>
        <p>
          Obtaining the order is the beginning, not the end. It is temporary and has to be defended until the main case is decided, and mishandling the period after it can lead to the order being lifted on the other party's application.
        </p>
        <h3>Keep your evidence organised</h3>
        <p>
          Every incident, message or development that relates to the grounds for the order should be documented and kept. Your lawyer will need this to justify keeping the order in place when the main case comes before the court.
        </p>
        <h3>Respond promptly to challenges</h3>
        <p>
          Your spouse can challenge the order: an order on petition can be appealed within one week (Article 6 of Federal Decree-Law No. 41 of 2024), and either side can ask the court to vary or lift a temporary order. Attend any hearing with your lawyer and be ready to support the order with evidence.
        </p>
        <h3>Coordinate with your divorce proceedings</h3>
        <p>
          Temporary orders feed into the main case, and the final orders on custody, finances and property replace them. In Abu Dhabi, the ADJD says an urgent request made before the main case requires you to commit to filing the main case within 8 days, so plan both together.
        </p>
        <div class="info-box info-box--info">
          <h3>Cost of emergency applications</h3>
          <p>Court fees depend on the emirate and the order. In Abu Dhabi the ADJD lists AED 100 for a Personal Status interim order, with alimony requests free of charge, AED 300 for a general application and AED 400 for a travel ban; check the fee shown when you file elsewhere. Lawyers' fees for an urgent application are not regulated, so ask for a fixed quote that covers drafting, attendance and any challenge.</p>
        </div>
      </section>

      <FAQSection items={faqItems} />

      <div class="cta-box">
        <h2>If You Are in an Urgent Situation, Act Now</h2>
        <p>Urgent applications in a UAE divorce need a lawyer who can move fast. A short consultation will tell you which orders are available, what evidence you need and whether your situation qualifies for an urgent request.</p>
        <LeadForm source="emergency-orders-divorce-uae" />
      </div>

      <section class="content-section">
        <h2>Related Guides</h2>
        <div class="related-grid">
          <a href="/en/temporary-alimony-uae/" class="related-card">
            <span class="related-title">Temporary Alimony in the UAE</span>
