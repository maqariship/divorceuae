---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Alimony in UAE: What You Can Claim After Divorce (2026)';
const description =
  'Alimony in the UAE explained: iddah maintenance, mutaa, child support, housing, and non-Muslim spousal support under Article 9. How courts calculate amounts and how to enforce non-payment.';

const hreflang = {
  en: 'https://divorceu.ae/en/alimony-uae/',
  ar: 'https://divorceu.ae/ar/نفقة-بعد-الطلاق-الامارات/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Alimony UAE', url: 'https://divorceu.ae/en/alimony-uae/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Alimony in UAE: What You Can Claim After Divorce (2026)',
  description:
    'A guide to alimony and maintenance entitlements in the UAE for Muslim and non-Muslim divorces, including how courts calculate amounts and how to enforce non-payment.',
  author: {
    '@type': 'Person',
    name: 'Aleksi Suon',
    jobTitle: 'UAE Expat & Legal Consultant',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Divorce UAE',
    url: 'https://divorceu.ae',
  },
  datePublished: '2025-11-10',
  dateModified: '2026-10-12',
  mainEntityOfPage: 'https://divorceu.ae/en/alimony-uae/',
};

const alimonyTypes = [
  {
    type: 'Iddah Maintenance (Nafaqat Al-Iddah)',
    who: 'Muslim wives',
    duration: 'The iddah: three periods of purity, three lunar months, or until delivery (Articles 84, 85)',
    basis: 'Muslim law (41/2024)',
    detail: 'Whether iddah maintenance is owed depends on the type of divorce. Under Article 101 of Federal Decree-Law No. 41 of 2024, it is owed during the iddah after a revocable divorce. After an irrevocable divorce it is owed only if the wife is pregnant, until she gives birth, and after khul\' there is no iddah maintenance at all. Housing for the iddah, in the marital home or a suitable alternative, is owed in every case. The iddah is three periods of purity, three lunar months if she does not menstruate, or until the birth of the child if the wife is pregnant (Articles 84 and 85). Iddah does not apply to non-Muslim divorces.',
  },
  {
    type: "Mut'a (Consolation Payment)",
    who: 'Muslim wives divorced by the husband without their request or fault',
    duration: 'One-time payment',
    basis: 'Muslim law (41/2024)',
    detail: "Mut'a is a one-time consolation payment, separate from iddah maintenance, owed after a consummated marriage when the husband divorces his wife of his own will without a request or cause from her, or when the divorce or annulment was due to him (Article 102 of Federal Decree-Law No. 41 of 2024). The court sets it according to the husband's means and the harm she suffered, and it cannot exceed one year's maintenance for a woman of her standing. The court can order it in instalments.",
  },
  {
    type: 'Child Support (Nafaqat Al-Awlad)',
    who: 'The custodial parent, usually the mother',
    duration: 'Muslim track: a daughter until she marries or works, a son until he can earn a living, longer while studying (Article 106)',
    basis: 'Muslim and civil law',
    detail: 'Child support is separate from any support paid to the wife. It covers the direct needs of the children: food, clothing, schooling, medical care, and their share of housing. Under Article 106 of Federal Decree-Law No. 41 of 2024 the father maintains a child who has no money of their own, regardless of who holds custody, and a claim for past child maintenance is not heard for more than one year before filing (Article 111). Courts set amounts based on the father’s means and the children’s reasonable needs.',
  },
  {
    type: 'Housing for the Custodian',
    who: 'The custodial parent, usually the mother',
    duration: 'For the duration of the custody period',
    basis: 'Muslim law (41/2024)',
    detail: "Under Article 119 of Federal Decree-Law No. 41 of 2024, whoever owes the child's maintenance must pay the custodian's housing rent, unless she owns a home she lives in or one is allotted for her to live in, and the judge can award housing rent large enough to cover the children living with her. Because custody now runs to 18 (Article 123), this can last far longer than iddah support.",
  },
  {
    type: 'Court-Ordered Spousal Support (Non-Muslims)',
    who: 'Non-Muslim ex-wives',
    duration: 'A period set by the court, reviewable yearly or when circumstances change',
    basis: 'Civil law (41/2022)',
    detail: "For non-Muslim couples under Federal Decree-Law No. 41 of 2022, a divorced woman may apply for alimony after the divorce judgment, and the judge decides whether to grant it and for how long using the factors listed in Article 9 (unless the marriage contract already covers it). There is no iddah in the civil track, so support is not limited to an iddah period. Article 9 also says alimony lapses if she remarries and that a new application to change it can be made after each year or when circumstances change. Separately, the court can award lump-sum compensation after a civil divorce (Article 6 of Cabinet Resolution No. 122 of 2023).",
  },
  {
    type: 'Financial Settlement of Property (Non-Muslims)',
    who: 'Either non-Muslim spouse',
    duration: 'One-time on divorce',
    basis: 'Civil law (41/2022)',
    detail: 'There is no automatic community-property split under the civil law. The UAE has no default 50/50 division of marital assets. Property is generally held by whoever holds legal title, and the court assesses each spouse\'s financial and non-financial contributions, needs, and any agreement between them. A spouse who contributed can raise a claim, and jointly owned property may be sold or one share bought out. See the property division guide below for the detail.',
  },
];

const calculationFactors = [
  { factor: "Husband's or payer's net monthly income", weight: 'Very High', detail: 'The primary benchmark. In the civil track the financial circumstances of both spouses are commonly assessed through a court-appointed accountant.' },
  { factor: 'Length of marriage',           weight: 'High',      detail: 'A named factor for non-Muslim spousal support: the longer the marriage, the higher the alimony (Article 9 of Federal Decree-Law No. 41 of 2022). In the Muslim track it is not a listed factor for maintenance, which turns on the payer’s means and the recipient’s needs (Article 96).' },
  { factor: "Wife's age and earning capacity", weight: 'Medium', detail: 'The wife\'s age is a named factor in the civil track. If she is employed or has clear earning capacity, the court may adjust support accordingly.' },
  { factor: 'Standard of living during the marriage', weight: 'High', detail: 'Maintenance aims to preserve a reasonable standard of living rather than reduce it sharply.' },
  { factor: 'Number and age of children',   weight: 'High',      detail: 'More children and younger children increase child support and extend the housing entitlement.' },
  { factor: 'Who initiated the divorce and any harm caused', weight: 'Medium', detail: 'Mut’a is owed only where the husband ended a consummated marriage by his own will without her request or cause, or the separation was due to him, and the harm she suffered is considered (Article 102). In the civil track the husband’s part in the breakdown and any material or moral harm are listed factors (Article 9).' },
  { factor: 'Registered agreement or prenuptial terms', weight: 'High', detail: 'A valid registered agreement can shape or override default entitlements, and courts honour agreements that meet the legal requirements.' },
];

const indicativeAmounts = [
  { item: 'Iddah maintenance (Muslim)', range: 'AED 3,000 to 15,000 per month for about 3 months', note: 'Only after a revocable divorce, or an irrevocable one if she is pregnant; none after khul\'. Scales with the husband\'s income.' },
  { item: "Mut'a consolation (Muslim)", range: 'Legal ceiling of one year\'s maintenance for a woman of her standing', note: 'One-time payment. Within the cap the court weighs the husband\'s means and the harm she suffered (Article 102).' },
  { item: 'Child support per child', range: 'Commonly 15 to 30 percent of the father\'s verified income', note: 'Rises with school fees, medical needs, and housing.' },
  { item: 'Non-Muslim spousal support (civil)', range: 'No fixed range; set case by case under Article 9', note: 'Assessed by a court-appointed accountant, reviewable annually.' },
  { item: 'Abu Dhabi civil benchmark', range: 'A guide of no less than 25 percent of the husband’s last monthly income multiplied by years of marriage', note: 'Article 18 of the 2022 Regulation (ADJD Chairman’s Decision No. 8 of 2022) for estimating financial compensation after divorce, Abu Dhabi Civil Family Court only. A guide, not a cap: the court can go higher or lower.' },
];

const enforcementSteps = [
  { title: 'Open a file at the execution court', detail: 'Once you hold an enforceable maintenance order, your lawyer files it with the execution court. In the Muslim track, continuing maintenance due from the date the claim was filed is a privileged debt that ranks ahead of the payer’s other debts, while maintenance for earlier periods is an ordinary debt (Article 98 of Federal Decree-Law No. 41 of 2024).' },
  { title: 'Wage garnishment (salary deduction)', detail: 'The court can order the payer\'s employer to deduct maintenance directly from salary and pay it to you before the rest of the salary is released. This is often the most reliable route where the ex-spouse is a salaried employee in the UAE.' },
  { title: 'Bank account freezing and seizure', detail: 'The court can freeze bank accounts and direct that the owed amount be transferred. Where funds exist, this can recover both current and backdated maintenance.' },
  { title: 'Travel ban', detail: 'The execution court can impose a travel ban that stops the payer from leaving the country until the debt is settled. For an ex-spouse who works or travels internationally, this is a strong pressure point.' },
  { title: 'Seizure of assets', detail: 'If salary and accounts are not enough, the court can move against other assets, including vehicles and, in some cases, property, to satisfy the outstanding maintenance.' },
];

const faqItems = [
  {
    question: "Can I get temporary alimony in the UAE while my divorce is pending?",
    answer:
      "Yes. For Muslims, Article 100 of Federal Decree-Law No. 41 of 2024 lets the court, at the wife's request, order temporary maintenance for her and the children while her maintenance case is heard, and the decision is enforceable immediately by force of law. For non-Muslims under Federal Decree-Law No. 41 of 2022, a divorced woman can ask for temporary alimony after the divorce judgment until her financial rights are decided, on form No. 4 with both spouses' monthly income and six months of account statements (Article 10 of Cabinet Resolution No. 122 of 2023); in Abu Dhabi the Civil Family Court has a similar rule (Article 21 of its 2022 Regulation). The order is provisional and is replaced by the final judgment.",
  },
  {
    question: 'How much alimony does a wife get in UAE?',
    answer:
      "There is no fixed formula, and amounts vary with the payer's income, the length of the marriage, and the number of children. As an indicative guide only, iddah maintenance for a Muslim wife, where it is owed (after a revocable divorce, or an irrevocable one if she is pregnant), often ranges from AED 3,000 to 15,000 per month for about three months. Mut'a, where the husband ended a consummated marriage by his own will without her request or cause, cannot exceed one year's maintenance for a woman of her standing under Article 102 of Federal Decree-Law No. 41 of 2024. Law-firm guides put child support at roughly 15 to 30 percent of the father's verified income per child, but no law sets a percentage. For non-Muslim couples the court sets spousal support case by case under the Article 9 factors of Federal Decree-Law No. 41 of 2022, assessed by a court-appointed accountant.",
  },
  {
    question: 'How long does alimony last in UAE under Muslim law?',
    answer:
      "For Muslim couples under Federal Decree-Law No. 41 of 2024, financial support to the ex-wife is limited to the iddah period, three periods of purity or three lunar months, or until delivery if she is pregnant (Articles 84 and 85), plus any one-time mut'a. Iddah maintenance itself is owed after a revocable divorce, after an irrevocable divorce only if she is pregnant, and not after khul', while iddah housing is owed in every case (Article 101). Long-term alimony beyond iddah is not automatic. Child support continues much longer: for a daughter until she marries or works, and for a son until he can earn a living, or longer while he studies (Article 106), and the custodian's housing rent is paid while custody lasts (Article 119).",
  },
  {
    question: 'Does a non-Muslim wife get alimony in UAE?',
    answer:
      "Yes. Under Federal Decree-Law No. 41 of 2022 for non-Muslims, a divorced woman may claim spousal support, and because there is no iddah the support is not capped at three months. The court weighs the factors listed in Article 9, including the length of the marriage, the wife's age, the financial circumstances of both spouses assessed by a court-appointed accountant, and compensation for harm. It is important to be clear that the civil law does not impose an automatic 50/50 split of marital property, and the UAE has no community-property regime.",
  },
  {
    question: 'Is marital property split 50/50 for non-Muslims in the UAE?',
    answer:
      "No. This is a common misunderstanding. Federal Decree-Law No. 41 of 2022 does not create an automatic 50/50 community-property division, and UAE law has no community-property concept. Assets are generally held by whoever holds legal title. The court assesses each spouse's financial and non-financial contributions, their needs, and any agreement between them, and a spouse who contributed can raise a claim. A woman may also claim spousal support weighed under the Article 9 factors.",
  },
  {
    question: 'What happens if my ex-husband refuses to pay alimony in UAE?',
    answer:
      "Non-payment of a court-ordered maintenance award is enforceable through the execution court. The court can order wage garnishment that deducts support directly from salary, freeze and seize bank accounts, impose a travel ban that stops the payer leaving the country, and seize other assets. Backdated maintenance can also be pursued. Speak to your lawyer as soon as payments stop, and see our dedicated guide on enforcing unpaid alimony.",
  },
  {
    question: "What is the difference between mahr and alimony in UAE?",
    answer:
      "Mahr is the property the husband pays the wife under the marriage contract, and it belongs to her (Article 45 of Federal Decree-Law No. 41 of 2024). Any deferred part becomes due when the separation becomes irrevocable or on the death of either spouse (Article 46), so after a revocable talaq it falls due when the iddah ends without a take-back. Alimony, or nafaqa, is financial maintenance. They are separate entitlements, and a wife may claim both unpaid mahr and maintenance.",
  },
  {
    question: 'Can I claim alimony retroactively in UAE?',
    answer:
      "Only within limits. Under Article 99 of Federal Decree-Law No. 41 of 2024, a claim for a wife's maintenance is not heard for any period more than two years before the date the claim is filed. Separately, if you later ask the court to increase an existing maintenance order, Article 97 lets the increase reach back no more than six months. In practice, courts are reluctant to award maintenance for long periods when no claim was filed, so it is best to file your maintenance claim during divorce proceedings rather than after.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  dir="ltr"
  hreflang={hreflang}
  schema={articleSchema}
  lastmod="2026-10-12"
>
  <header class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <Breadcrumb items={breadcrumbs} lang="en" />
        <h1 class="hero__h1">
          Alimony in UAE:<br />What Are You Entitled to?
        </h1>
        <p class="byline" style="font-size:0.85rem;opacity:0.8;margin-bottom:20px;">By Aleksi Suon, UAE Expat &amp; Legal Consultant · Updated October 2026</p>
        <p class="hero__sub">
          UAE alimony law works differently for Muslim and non-Muslim couples, and it was reshaped by the 2022 civil law
          and the 2024 Muslim personal status law. This guide explains every type of financial entitlement after divorce
          in the UAE, how amounts are calculated, and how to enforce payment if your ex-spouse stops paying.
        </p>
        <ul class="hero__trust">
          <li>✓ Muslim &amp; non-Muslim rules</li>
          <li>✓ 2022 and 2024 laws explained</li>
          <li>✓ Free first consultation</li>
          <li>✓ 100% confidential</li>
        </ul>
        <p class="hero__author">Guide by <strong>Aleksi Suon</strong>, UAE Expat &amp; Legal Consultant. Last updated 12 October 2026.</p>
      </div>
      <div class="hero__form">
        <LeadForm lang="en" variant="hero" />
      </div>
    </div>
  </header>

  <main class="container main-content">

    <!-- What is alimony in UAE -->
    <section class="section" aria-labelledby="what-heading">
      <h2 id="what-heading">What Is Alimony in UAE?</h2>
      <p>
        In the UAE, "alimony" is an umbrella term for several distinct financial entitlements that arise on divorce. The
        Arabic word <em>nafaqa</em> means financial maintenance, and UAE law separates it carefully by who receives it and
        under what circumstances. A former wife, the children, and the custodial parent can each have separate claims, and
        a woman may hold more than one at the same time.
      </p>
      <p>
        The rules depend on whether the couple is Muslim or non-Muslim, because the UAE now runs a dual system. Muslim
        couples are governed by <strong>Federal Decree-Law No. 41 of 2024</strong>, the Muslim personal status law that
        came into force on 15 April 2025 and replaced the older 2005 law in full. Non-Muslim residents are generally
        governed by <strong>Federal Decree-Law No. 41 of 2022</strong> on civil personal status, in force since 1 February
        2023 across all seven emirates, unless a party elects to apply the law of their home country. If you want the wider
        picture of both tracks, start with our overview of <a href="/en/uae-divorce-law/">UAE divorce law</a>.
      </p>
      <div class="info-box">
        <h3>Key distinction: Muslim vs non-Muslim</h3>
        <div class="info-grid">
          <div class="info-col">
            <p class="info-label">Muslim couples (41/2024)</p>
            <ul>
              <li>Iddah maintenance where the divorce type allows it; iddah housing always</li>
              <li>Mut'a consolation payment (one-time, capped)</li>
              <li>Child support (ongoing)</li>
              <li>Housing allowance during custody</li>
              <li>No automatic long-term alimony</li>
            </ul>
          </div>
          <div class="info-col">
            <p class="info-label">Non-Muslim residents (41/2022)</p>
            <ul>
              <li>Court-ordered spousal support (Article 9)</li>
              <li>No iddah, so support is not limited to an iddah period</li>
              <li>Reviewable annually, forfeited on remarriage</li>
              <li>Child support (ongoing)</li>
              <li>No automatic 50/50 property split</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Types of alimony -->
    <section class="section" aria-labelledby="types-heading">
      <h2 id="types-heading">Types of Alimony &amp; Financial Entitlements in UAE</h2>
      <p>
        Below is a breakdown of every financial entitlement that can arise after divorce in the UAE. Read them as a set,
        because most divorcing spouses hold several at once. A Muslim wife with young children, for example, may claim
        iddah maintenance, mut'a, child support, and a housing allowance, plus any unpaid deferred mahr.
      </p>

      <div class="alimony-cards">
        {alimonyTypes.map((item) => (
          <div class="alimony-card">
            <div class="alimony-card__header">
              <h3>{item.type}</h3>
              <span class="alimony-badge">{item.basis}</span>
            </div>
            <div class="alimony-meta">
              <span><strong>Who:</strong> {item.who}</span>
              <span><strong>Duration:</strong> {item.duration}</span>
            </div>
            <p>{item.detail}</p>
          </div>
        ))}
      </div>

      <div class="callout callout--warning">
        <h3>Correcting a common myth: there is no automatic 50/50 split</h3>
        <p>
          Many websites claim that non-Muslim marital assets are "divided equally" or "split 50/50 by default" under the
          2022 civil law. That is not accurate. Federal Decree-Law No. 41 of 2022 does not impose a community-property
          division, and UAE law has no community-property concept at all. Property is generally held by whoever holds legal
          title. On divorce the court assesses each spouse's financial and non-financial contributions, their needs, and
          any agreement between them, and a spouse who contributed can raise a claim. Separately, a divorced woman may claim
          spousal support weighed under the Article 9 factors. Treat any "guaranteed half" promise with caution and read our
          <a href="/en/property-division-divorce-uae/">property division in UAE divorce</a> guide for how title, contributions,
          and buy-outs actually work.
        </p>
      </div>
    </section>

    <!-- Muslim vs non-Muslim comparison -->
    <section class="section" aria-labelledby="compare-heading">
      <h2 id="compare-heading">Muslim vs Non-Muslim Alimony: Side by Side</h2>
      <p>
        The single biggest factor in what you can claim is which law applies to your divorce. The table below sets the two
        federal tracks against each other on the points that matter most for maintenance.
      </p>
      <div class="compare-table">
        <div class="compare-row compare-row--head">
          <span>Point</span>
          <span>Muslim (41/2024)</span>
          <span>Non-Muslim (41/2022)</span>
        </div>
        <div class="compare-row">
          <span>Support to the ex-wife</span>
          <span>Iddah maintenance for the iddah only (revocable divorce, or pregnancy), plus iddah housing (Article 101)</span>
          <span>Spousal support on application after the divorce, for a period the judge sets (Article 9)</span>
        </div>
        <div class="compare-row">
          <span>One-time consolation</span>
          <span>Mut'a, up to one year's maintenance, where the husband ends the marriage without her request</span>
          <span>Harm is a factor in alimony (Article 9), and the court can award lump-sum compensation (Article 6 of Cabinet Resolution No. 122 of 2023)</span>
        </div>
        <div class="compare-row">
          <span>How the amount is set</span>
          <span>The payer's means, the recipient's condition and the cost of living at the time and place (Article 96)</span>
          <span>Article 9 factors, income assessed by a court-appointed accountant</span>
        </div>
        <div class="compare-row">
          <span>Review over time</span>
          <span>Can be raised or lowered on changed circumstances, but not within a year of the ruling becoming final save exceptional cases; increases reach back at most six months (Article 97)</span>
          <span>New application after each year or when circumstances change (Article 9)</span>
        </div>
        <div class="compare-row">
          <span>Ends on remarriage</span>
          <span>Iddah maintenance is short by design</span>
          <span>Spousal support is forfeited on remarriage</span>
        </div>
        <div class="compare-row">
          <span>Property</span>
          <span>Held by title; mahr is the wife's separate right</span>
          <span>No automatic 50/50; contribution-based claims</span>
        </div>
        <div class="compare-row">
          <span>Child support</span>
          <span>Father liable for a child without money of their own (Article 106)</span>
          <span>Set by the court case by case; in Abu Dhabi the father keeps paying the costs he met before the divorce (Article 23 of the 2022 Regulation)</span>
        </div>
      </div>
      <p>
        Non-Muslim foreigners can also have their home-country law applied where one of them insists on it (Article 1 of
        Federal Decree-Law No. 41 of 2022). That choice can
        change the financial outcome significantly, so it is a decision to take with a lawyer before filing. Expats weighing this should read our guide to
        <a href="/en/divorce-for-expats-in-uae/">divorce for expats in the UAE</a>.
      </p>
    </section>

    <!-- How courts calculate -->
    <section class="section" aria-labelledby="calculation-heading">
      <h2 id="calculation-heading">How UAE Courts Calculate Alimony Amounts</h2>
      <p>
        There is no single alimony formula in UAE federal law. Judges assess amounts against a set of established factors,
        and in the civil track the financial position of both spouses is often verified by a court-appointed accountant
        rather than taken on trust. Understanding these factors helps you set realistic expectations and prepare the right
        evidence.
      </p>

      <div class="factors-table">
        {calculationFactors.map((item) => (
          <div class="factor-row">
            <div class="factor-info">
              <h3>{item.factor}</h3>
              <p>{item.detail}</p>
            </div>
            <span class={`factor-weight ${item.weight === 'Very High' ? 'weight--high' : item.weight === 'High' ? 'weight--high' : 'weight--medium'}`}>
              {item.weight}
            </span>
          </div>
        ))}
      </div>

      <p>
        One regional benchmark is worth flagging because it is often quoted as if it were a national rule. In the Abu Dhabi
        Civil Family Court, Article 18 of the 2022 Regulation (ADJD Chairman's Decision No. 8 of 2022) says that, when
        estimating the financial compensation due after divorce, the court and its accounting expert may be guided by a
        cash percentage of no less than 25 percent of the husband's last monthly income multiplied by the number of years
        of marriage, alongside yardsticks based on his property and the couple's joint account. It is a guide, not a cap
        (summaries that say "up to 25 percent" have it backwards), and the court can raise or lower the figure, choose how
        to calculate it and order instalments (Article 18(2)). That guide is specific to Abu Dhabi and is not the federal
        rule under 41/2022. If your case is in Dubai or another emirate, do not assume the 25 percent benchmark applies.
        Our guide to <a href="/en/alimony-abu-dhabi/">spousal maintenance in Abu Dhabi</a> sets out how both Abu Dhabi
        courts assess it.
      </p>

      <div class="cta-inline">
        <p>Want a rough figure before you speak to a lawyer?</p>
        <a href="/en/alimony-calculator-uae/" class="btn btn--primary">Try the Alimony Calculator</a>
      </div>
    </section>

    <!-- Financial disclosure -->
    <section class="section" aria-labelledby="disclosure-heading">
      <h2 id="disclosure-heading">Financial Disclosure and the Court-Appointed Accountant</h2>
      <p>
        Whatever the track, a maintenance award is only as good as the income figure it rests on. This is where many claims
        succeed or fail. In the civil track under Federal Decree-Law No. 41 of 2022, the financial circumstances of both
        spouses are commonly assessed by a court-appointed accountant rather than accepted on either party's word. The
        accountant reviews salary records, bank statements, and business income, and reports back to the judge, which makes
        it harder for a higher-earning spouse to understate what they actually make.
      </p>
      <p>
        Two practical points follow from this. First, gather your evidence early and keep it organised, because the stronger
        your documentation of both the payer's income and your own standard of living, the better the outcome. Second, be
        realistic about self-employed or business-owner spouses. Where income is not a simple monthly salary, the court may
        need to look at dividends, drawings, and company accounts, and forensic tracing is sometimes required. If assets are
        held offshore or through corporate structures, this adds time and cost, and it is one reason contested cases run
        longer and cost more.
      </p>
      <p>
        Disclosure also matters for enforcement later. A clear record of the payer's employer and bank details, built up
        during the case, is exactly what the execution court needs if payments stop, so good disclosure work at the
        maintenance stage pays off twice.
      </p>
    </section>

    <!-- Indicative amounts -->
    <section class="section" aria-labelledby="amounts-heading">
      <h2 id="amounts-heading">Indicative Alimony Amounts in the UAE</h2>
      <p>
        The figures below are indicative ranges drawn from UAE law-firm guides, not an official schedule. Actual awards
        vary widely by income, emirate, and the facts of each case. Use them to frame a conversation with a lawyer, not as
        a promise of what a court will order.
      </p>
      <div class="amounts-table">
        <div class="amounts-row amounts-row--head">
          <span>Entitlement</span>
          <span>Indicative range</span>
          <span>Notes</span>
        </div>
        {indicativeAmounts.map((row) => (
          <div class="amounts-row">
            <span class="amounts-item">{row.item}</span>
            <span>{row.range}</span>
            <span class="amounts-note">{row.note}</span>
          </div>
        ))}
      </div>
      <p>
        For a fuller picture of what a divorce costs alongside any maintenance you receive, including court fees, translation,
        and lawyer fees, see our breakdown of the <a href="/en/divorce-cost-uae/">cost of divorce in the UAE</a>. If children
        are involved, the child element usually dwarfs any spousal element, so read the dedicated
        <a href="/en/child-support-uae/">child support in the UAE</a> guide as well.
      </p>
    </section>

    <!-- Child support and housing detail -->
    <section class="section" aria-labelledby="children-heading">
      <h2 id="children-heading">Child Support and Housing: The Ongoing Entitlements</h2>
      <p>
        Where there are children, the child element of maintenance usually outlasts and outweighs anything paid to the
        former wife. Support to the ex-wife is short in the Muslim track and time-limited in the civil track, but child
        support (nafaqat al-awlad) runs much longer. Under Article 106 of Federal Decree-Law No. 41 of 2024, the father
        maintains a child who has no money of their own, regardless of who holds custody: a daughter until she marries or
        works, and a son until he reaches the age at which his peers earn a living, or longer while he studies. Maintenance
        covers food, clothing, housing, medical treatment and education according to custom (Article 95).
      </p>
      <p>
        Housing is a distinct entitlement that people often miss. Under Article 119, whoever owes the child's maintenance
        must pay the custodian's housing rent, unless she owns a home she lives in or one is allotted for her to live in,
        and the judge can set the rent at a level that covers the children living with her. Because custody now runs to 18
        under the 2024 law (Article 123), this can last far longer than the short iddah support, which is why the housing
        figure often matters more than the headline alimony number.
      </p>
      <p>
        Child support is reviewable as circumstances change. School fees rise, medical needs appear, and the father's income
        can move up or down, so a figure set today is not fixed forever. Our
        <a href="/en/child-support-uae/">child support in the UAE</a> guide sets out how the father's obligation is
        calculated, what counts as a reasonable need, and how to return to court if an existing order no longer reflects the
        children's real costs.
      </p>
    </section>

    <!-- Temporary alimony -->
    <section class="section" aria-labelledby="temporary-heading">
      <h2 id="temporary-heading">Temporary Alimony While the Divorce Is Pending</h2>
      <p>
        Yes, you can ask for temporary maintenance before the money questions are finally decided, but the rule
        differs by track. For Muslims, Article 100 of Federal Decree-Law No. 41 of 2024 lets the court, at the wife's
        request and during the hearings of her maintenance case, order temporary maintenance for her and the children
        from the respondent, and that decision is enforceable immediately by force of law. Requests for urgent and
        temporary maintenance orders are not sent to Family Guidance first (Article 8).
      </p>
      <p>
        For non-Muslims under Federal Decree-Law No. 41 of 2022, temporary alimony comes after the divorce judgment:
        the divorced wife can ask for it until her financial rights are decided, on form No. 4, with documents showing
        both spouses' monthly income and their last six months of account statements. The court decides by an order
        on a petition and may refuse if she has a job or fixed income covering her basic needs (Article 10 of Cabinet
        Resolution No. 122 of 2023). The order is provisional either way. It is replaced when the final judgment sets
        the long-term amounts, and unpaid amounts can be enforced through the execution court. For the forms,
        evidence and step-by-step procedure in each emirate, see our guide to
        <a href="/en/temporary-alimony-uae/">temporary alimony in the UAE</a>.
      </p>
      <p>
        Temporary maintenance sits alongside the other urgent tools covered in our guide to
        <a href="/en/emergency-orders-divorce-uae/">emergency and interim orders in a UAE divorce</a>, such as
        travel bans and asset seizures. If your case is in Abu Dhabi, where non-Muslim couples use the Civil Family
        Court and Article 21 of its 2022 Regulation sets a similar rule, see
        <a href="/en/alimony-abu-dhabi/">temporary spousal maintenance in Abu Dhabi</a> for how it is requested
        there. If an interim order is ignored, the steps in
        <a href="/en/unpaid-alimony-enforcement-uae/">enforcing unpaid alimony</a> apply straight away; you do not
        have to wait for the final decree.
      </p>
    </section>

    <!-- How to claim -->
    <section class="section" aria-labelledby="claim-heading">
      <h2 id="claim-heading">How to Claim Alimony in UAE, Step by Step</h2>
      <ol class="steps">
        <li>
          <h3>Step 1: Consult a family lawyer early</h3>
          <p>
            Do not wait until the divorce is finalised. Maintenance claims are far stronger when filed during proceedings,
            and backdated maintenance is limited. A lawyer will identify your specific entitlements and file the right
            claims alongside the divorce petition.
          </p>
        </li>
        <li>
          <h3>Step 2: Gather financial evidence</h3>
          <p>
            The court needs proof of the payer's income, such as salary certificates, bank statements, and business
            income. Gather evidence of your standard of living during the marriage as well: rent or mortgage, school fees,
            household and lifestyle costs. In the civil track a court-appointed accountant may review the financial
            picture, so clear documentation matters.
          </p>
        </li>
        <li>
          <h3>Step 3: File a maintenance claim at the Personal Status Court</h3>
          <p>
            Your lawyer files a nafaqa claim at the Personal Status Court in the emirate where you live, alongside or
            immediately after the divorce filing; a wife can file where either spouse lives or works or where the marital
            home is (Article 3 of Federal Decree-Law No. 41 of 2024). While the maintenance case runs, the court can order
            temporary maintenance for the wife and children that is enforceable immediately (Article 100).
          </p>
        </li>
        <li>
          <h3>Step 4: Attend the hearing</h3>
          <p>
            Both sides present their financial positions. Your lawyer argues for the appropriate level of maintenance based
            on the payer's income and your established standard of living. The judge may request further documentation or
            an accountant's report before ruling.
          </p>
        </li>
        <li>
          <h3>Step 5: Enforce the order if payment stops</h3>
          <p>
            A maintenance order is legally enforceable. If your ex-spouse does not pay, the execution court can garnish
            wages, freeze accounts, and impose a travel ban. The enforcement section below explains exactly how this works.
          </p>
        </li>
      </ol>
    </section>

    <!-- ENFORCEMENT -->
    <section class="section" aria-labelledby="enforce-heading">
      <h2 id="enforce-heading">What Happens If Your Ex Refuses to Pay: Enforcement in the UAE</h2>
      <p>
        Non-payment is the single biggest fear for people who are owed maintenance, and it is a fear the UAE system takes
        seriously. A maintenance judgment is treated as an enforceable debt. Once you hold a final order, you do not have to
        rely on goodwill. You take the order to the execution court, which has real tools to make an unwilling ex-spouse pay.
      </p>

      <div class="enforce-list">
        {enforcementSteps.map((step, i) => (
          <div class="enforce-item">
            <span class="enforce-num">{i + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <p>
        These measures can be combined. In practice a wage garnishment plus a travel ban is a powerful pairing, because a
        salaried ex-spouse who wants to keep working and travelling in the UAE has a strong incentive to clear the debt.
        Arrears already fixed by a judgment remain a debt, and for maintenance that was never claimed, Article 99 of
        Federal Decree-Law No. 41 of 2024 lets a wife's claim reach back up to two years before the filing date, so a
        period of non-payment does not simply vanish.
      </p>
      <p>
        Enforcement is a specialist process, and getting the file opened correctly at the execution court matters. Our
        dedicated guide on <a href="/en/unpaid-alimony-enforcement-uae/">enforcing unpaid alimony in the UAE</a> walks
        through the execution court steps, the documents you need, and how travel bans and salary deductions are applied in
        practice.
      </p>
    </section>

    <!-- Iddah context -->
    <section class="section" aria-labelledby="iddah-heading">
      <h2 id="iddah-heading">Iddah Maintenance and Why Timing Matters</h2>
      <p>
        For Muslim wives, the iddah is the most immediate stage, but what it carries depends on the type of divorce. Under
        Article 101 of Federal Decree-Law No. 41 of 2024, during the iddah (three periods of purity, three lunar months if
        she does not menstruate, or until delivery if she is pregnant, Articles 84 and 85) the husband must pay maintenance
        after a revocable divorce. After an irrevocable divorce he pays maintenance only if she is pregnant, until the
        birth, and after khul' there is no iddah maintenance. In every case she may live in the marital home for the iddah,
        or in a suitable alternative if it is unsuitable. Because the window is short, raise the claim early rather than
        relying on the two-year look-back for past maintenance (Article 99). Non-Muslim divorces under the civil law have
        no iddah at all, which is why spousal support in that track is set for a court-determined period instead.
      </p>
      <p>
        For a full explanation of how the waiting period works, what it covers, and how it interacts with remarriage and
        paternity, see our guide to the <a href="/en/iddah-waiting-period-uae/">iddah waiting period in the UAE</a>.
      </p>
    </section>

    <!-- Mahr -->
    <section class="section" aria-labelledby="mahr-heading">
      <h2 id="mahr-heading">Do Not Forget Your Mahr: It Becomes Due on Divorce</h2>
      <p>
        Mahr is the property the husband pays the wife under the marriage contract. It is the wife's own property (Article
        45 of Federal Decree-Law No. 41 of 2024), not shared marital assets. If your mahr was partly deferred, as is common
        in UAE marriages, the deferred amount becomes due when the separation becomes irrevocable or on the death of either
        spouse (Article 46). After a revocable talaq that means when the iddah ends without a take-back. Once a court orders
        it, it is enforced through the execution court as a debt.
      </p>
      <p>
        Many women overlook this. Unpaid deferred mahr should be claimed at the same time as maintenance and child support.
        Our <a href="/en/mahr-divorce-uae/">mahr and divorce in the UAE</a> guide explains the prompt and deferred parts of
        mahr and how to claim what you are owed, and our
        <a href="/en/wife-rights-after-divorce-uae/">wife's rights after divorce</a> guide sets mahr alongside every other
        entitlement so nothing is missed.
      </p>
      <ul class="list">
        <li>Check your marriage contract for the agreed mahr amount</li>
        <li>Identify how much was paid upfront and how much is deferred</li>
        <li>Claim the full deferred mahr amount through your lawyer</li>
        <li>Mahr is separate from alimony, so you are entitled to both</li>
      </ul>
    </section>

    <!-- Common mistakes -->
    <section class="section" aria-labelledby="mistakes-heading">
      <h2 id="mistakes-heading">Common Mistakes That Reduce What You Receive</h2>
      <p>
        Most losses in maintenance cases are avoidable. They come from waiting too long, claiming too little, or trusting a
        promise that a court would never enforce. The points below are the ones that cost people money most often.
      </p>
      <ul class="list">
        <li><strong>Waiting until after the divorce is final.</strong> Maintenance claims are strongest when filed during proceedings, and backdated maintenance is limited, so a delay can permanently reduce what you can recover.</li>
        <li><strong>Believing the 50/50 myth.</strong> Non-Muslim spouses who assume they will automatically get half the assets often fail to file the contribution-based claim they actually need. There is no automatic community-property split under 41/2022.</li>
        <li><strong>Forgetting deferred mahr.</strong> Deferred mahr becomes due once the separation is irrevocable (Article 46) and can be enforced as a debt, yet it is frequently left unclaimed because it feels separate from the divorce itself.</li>
        <li><strong>Under-documenting the standard of living.</strong> The court awards against evidence, not memory. Rent, school fees, and lifestyle costs from during the marriage all support a higher figure.</li>
        <li><strong>Not planning for enforcement.</strong> Winning an order is only half the battle. Keeping records of the payer's employer and bank details makes execution far quicker if payments stop.</li>
      </ul>
      <p>
        If your case is a non-Muslim expat divorce, the choice between UAE law and your home-country law can change the whole
        financial picture, so decide it with a lawyer before filing. Our guide to
        <a href="/en/divorce-for-expats-in-uae/">divorce for expats in the UAE</a> and our overview of
        <a href="/en/uae-divorce-law/">UAE divorce law</a> both explain how that decision interacts with maintenance and
        property.
      </p>
    </section>

    <!-- Related links -->
    <section class="section" aria-labelledby="related-heading">
      <h2 id="related-heading">Related Legal Guides</h2>
      <div class="service-links">
        <a href="/en/unpaid-alimony-enforcement-uae/" class="service-link">
          <strong>Unpaid Alimony in the UAE</strong>
          <span>How to enforce a maintenance order: execution court, garnishment, travel ban</span>
        </a>
        <a href="/en/wife-rights-after-divorce-uae/" class="service-link">
          <strong>Wife's Rights After Divorce UAE</strong>
          <span>Every financial and housing right in one overview</span>
        </a>
        <a href="/en/child-support-uae/" class="service-link">
          <strong>Child Support UAE</strong>
          <span>How the father's obligation is calculated and enforced</span>
        </a>
        <a href="/en/property-division-divorce-uae/" class="service-link">
          <strong>Property Division in UAE Divorce</strong>
          <span>Why there is no automatic 50/50 split and how title works</span>
        </a>
        <a href="/en/divorce-for-expats-in-uae/" class="service-link">
          <strong>Divorce for Expats (2022 Law)</strong>
          <span>How the civil law changed things for non-Muslims</span>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} lang="en" />

    <!-- Bottom CTA -->
    <section id="contact" class="section section--cta" aria-labelledby="cta-heading">
      <h2 id="cta-heading">Speak to a UAE Family Lawyer About Your Entitlements</h2>
      <p>
        Alimony entitlements in the UAE are time-sensitive, so file your claim during proceedings, not after.
        Get a free confidential consultation with a qualified UAE family lawyer today.
      </p>
      <LeadForm lang="en" variant="inline" />
    </section>

  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p>&copy; 2026 DivorceU.AE, a legal referral service. Not a law firm. Information provided is for guidance only and does not constitute legal advice.</p>
