---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';

const title = 'DivorceU.AE بالعربية: دليل الطلاق والحضانة والنفقة في الإمارات';
const description =
  'أدلة عربية عن الطلاق في الإمارات مبنية على نص القانون: الإجراءات والحضانة والنفقة والمهر، مع محامين مرخّصين في دبي وأبوظبي واستشارة أولى مجانية.';

const hreflang = {
  en: 'https://divorceu.ae/en/',
  ar: 'https://divorceu.ae/ar/',
};

const faqItems = [
  {
    question: 'كم يستغرق الطلاق في دبي؟',
    answer:
      'لا يحدد القانون مدة ثابتة للطلاق في دبي. فالطلاق بالتراضي أسرع عادةً، أما المتنازع عليه فيطول بحسب نزاعات الحضانة والمال وجدول المحكمة. وطلاق غير المسلمين لا يُحال إلى التوجيه الأسري، بل يُعرض على المحكمة مباشرة ليُحكم فيه في الجلسة الأولى (المادة 3 من المرسوم بقانون اتحادي رقم 41 لسنة 2022).',
  },
  {
    question: 'ما هو الخُلع في قانون الإمارات؟',
    answer:
      'الخُلع فرقة بين الزوجين بطلب من الزوجة وقبول الزوج للعوض الذي تبذله، ويقع طلاقاً بائناً بينونة صغرى (المادة 65 من المرسوم بقانون اتحادي رقم 41 لسنة 2024). وإذا كان العوض هو المهر كفى ردّ ما قبضته منه وسقط الباقي، ولا يجوز أن يكون العوض التنازل عن حقوق الأولاد. وإذا تعنّت الزوج في قبول العوض حكمت المحكمة بالخلع مقابل عوض مناسب تقدّره (المادة 66). ويوثَّق الخلع أمام المحكمة خلال 15 يوماً (المادة 68).',
  },
  {
    question: 'من يحصل على حضانة الأطفال في الإمارات؟',
    answer:
      'وفق المرسوم بقانون اتحادي رقم 41 لسنة 2024 بشأن الأحوال الشخصية (النافذ منذ 15 أبريل 2025)، تستمر حضانة الأم عادةً حتى بلوغ الأولاد والبنات سن 18، ويحق للطفل عند بلوغه 15 عاماً اختيار الحاضن مع مراعاة مصلحته. وتبقى الولاية على شؤون الطفل للأب عادةً. أما غير المسلمين فالأصل عندهم الحضانة المشتركة وفق المرسوم بقانون رقم 41 لسنة 2022.',
  },
  {
    question: 'ما الذي يحدث لتأشيرتي بعد الطلاق في الإمارات؟',
    answer:
      'إذا كانت إقامتك على كفالة زوجك أو زوجتك، فسيلزمك بعد الطلاق تعديل وضعك خلال المهلة التي تحددها جهات الإقامة، وتختلف المدد والخيارات بحسب الإمارة ونوع الإقامة. تحقق من المهلة الحالية لدى الهيئة الاتحادية للهوية والجنسية والجمارك وأمن المنافذ أو الإدارة العامة للإقامة وشؤون الأجانب في دبي قبل الاعتماد على أي رقم. والخيارات الشائعة: إقامة عمل، أو كفالة أحد الوالدين للأطفال، أو أنواع الإقامة الأخرى المتاحة لك.',
  },
  {
    question: 'كم تكلفة الطلاق في دبي؟',
    answer:
      'تختلف رسوم المحكمة بحسب الإمارة ونوع الطلب، فراجع جدول الرسوم الحالي لمحاكم دبي قبل التقديم. أما في محكمة أبوظبي للأسرة المدنية فرسوم طلب الطلاق المدني 5,000 درهم (المادة 13 من لائحة 2022). وتُحدَّد أتعاب المحامي بحسب نوع العمل والجهد والوقت وأهمية القضية وخبرة المحامي (المادة 47 من المرسوم بقانون اتحادي رقم 34 لسنة 2022)، وتكون بعقد مكتوب قبل البدء. والاستشارة الأولى التي نرتبها لك مجانية.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="ar"
  dir="rtl"
  hreflang={hreflang}
>
  <!-- ===== هيرو ===== -->
  <header class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <h1 class="hero__h1">
          دليلك العربي للطلاق في الإمارات:<br />
          الحقوق والإجراءات والمحامي المناسب
        </h1>
        <p class="hero__sub">
          التعامل مع الطلاق في الإمارات أمر معقد. سواء كنت مسلماً أو غير مسلم، مقيماً أجنبياً أو مواطناً ،
          نساعدك في التواصل مع محامي أسرة مرخّص في دبي أو أبوظبي أو بقية الإمارات، يرشدك في كل خطوة
          من تقديم الطلب في محكمة الأحوال الشخصية إلى الحضانة والحقوق المالية. نحن خدمة معلومات وإحالة، ولسنا مكتب محاماة.
        </p>
        <ul class="hero__trust">
          <li>✓ استشارة أولى مجانية</li>
          <li>✓ دعم باللغتين العربية والإنجليزية</li>
          <li>✓ دبي وجميع الإمارات</li>
          <li>✓ سرية تامة</li>
        </ul>
      </div>

      <div class="hero__form">
        <LeadForm lang="ar" variant="hero" />
      </div>
    </div>
  </header>

  <main class="container main-content">

    <!-- ===== عملية الطلاق ===== -->
    <section class="section" aria-labelledby="process-heading">
      <h2 id="process-heading">كيفية تقديم طلب الطلاق في دبي: خطوة بخطوة</h2>
      <p>
        تُنظر قضايا الطلاق في دبي من قبل محكمة الأحوال الشخصية. إليك ما يمكن توقعه:
      </p>
      <ol class="steps">
        <li>
          <h3>الخطوة الأولى: استشارة محامي أسرة</h3>
          <p>قبل تقديم الطلب، استشر محامي أسرة مرخّصاً في الإمارات لفهم حقوقك والمسار المتاح لك. اقرأ <a href="/ar/استشارة-محامي-طلاق/">ماذا تشمل استشارة محامي الطلاق المجانية وكيف تستعد لها</a>.</p>
        </li>
        <li>
          <h3>الخطوة الثانية: التقديم في محكمة الأحوال الشخصية</h3>
          <p>قدم طلب الطلاق في محكمة الأحوال الشخصية في الإمارة التي تقيم فيها. المستندات المطلوبة: عقد الزواج، جوازات السفر، وبطاقة الهوية الإماراتية.</p>
        </li>
        <li>
          <h3>الخطوة الثالثة: التوجيه الأسري إذا أحالكم القاضي</h3>
          <p>للقاضي المشرف أن يحيل الزوجين المسلمين إلى التوجيه الأسري لمحاولة الصلح إذا رأى ذلك ممكناً، والإحالة جوازية وليست إلزامية، وتُستثنى منها الطلبات المستعجلة ودعاوى إثبات الطلاق (المادة 8 من المرسوم بقانون اتحادي رقم 41 لسنة 2024). أما طلاق غير المسلمين فلا يمر بهذه المرحلة أصلاً (المادة 3 من المرسوم بقانون اتحادي رقم 41 لسنة 2022).</p>
        </li>
        <li>
          <h3>الخطوة الرابعة: جلسات الاستماع</h3>
          <p>للطلاق بالتراضي، غالباً ما تكفي جلسة واحدة. أما القضايا المتنازع عليها فتستدعي جلسات متعددة.</p>
        </li>
        <li>
          <h3>الخطوة الخامسة: صدور حكم الطلاق</h3>
          <p>تصدر المحكمة حكم الطلاق. يجب تصديقه، وبالنسبة للمقيمين الأجانب، يتم توثيقه رسمياً للاعتراف به في بلدهم الأصلي.</p>
        </li>
      </ol>
    </section>

    <!-- ===== أدلة رئيسية ===== -->
    <section class="section" aria-labelledby="guides-heading">
      <h2 id="guides-heading">ابدأ من الدليل المناسب لحالتك</h2>
      <ul class="guide-links">
        <li><a href="/ar/محامي-طلاق-دبي/">محامي طلاق في دبي</a>: متى تحتاجه، وكيف تختاره، وطلب محامية.</li>
        <li><a href="/ar/محامي-طلاق-ابوظبي/">محامي طلاق في أبوظبي</a>: محكمة الأحوال الشخصية ومحكمة الأسرة المدنية.</li>
        <li><a href="/ar/محامي-طلاق/">محامي طلاق في الإمارات</a>: أدلة لكل إمارة.</li>
        <li><a href="/ar/استشارة-محامي-طلاق/">استشارة محامي طلاق مجانية</a>: ما تشمله وكيف تستعد لها.</li>
        <li><a href="/ar/محكمة-الأسرة-في-دبي/">محكمة الأحوال الشخصية في دبي</a>: الموقع والمواعيد وطريقة رفع الدعوى.</li>
        <li><a href="/ar/الطلاق-في-الامارات/">الطلاق في الإمارات</a>: المسارات للمسلمين وغير المسلمين.</li>
        <li><a href="/ar/حضانة-الاطفال-الامارات/">حضانة الأطفال بعد الطلاق</a> و<a href="/ar/نفقة-بعد-الطلاق-الامارات/">النفقة بعد الطلاق</a>.</li>
        <li><a href="/ar/نسبة-الطلاق-في-الامارات/">نسبة الطلاق في الإمارات</a>: الأرقام الرسمية.</li>
      </ul>
    </section>

    <!-- ===== أسئلة شائعة ===== -->
    <FAQSection items={faqItems} lang="ar" />

    <!-- ===== CTA سفلي ===== -->
    <section class="section section--cta" aria-labelledby="bottom-cta-heading">
      <h2 id="bottom-cta-heading">ابدأ استشارتك المجانية اليوم</h2>
      <p>
        اطلب استشارة أولى مجانية مع محامي طلاق مرخّص في دبي أو أبوظبي أو بقية الإمارات، بالعربية أو الإنجليزية.
        ولدينا أدلة مفصلة: <a href="/ar/محامي-طلاق-دبي/">محامي طلاق في دبي</a>، و<a href="/ar/محامي-طلاق-ابوظبي/">محامي طلاق في أبوظبي</a>، و<a href="/ar/كيفية-تقديم-الطلاق-في-الامارات/">كيفية تقديم الطلاق</a>.
      </p>
      <LeadForm lang="ar" variant="inline" />
    </section>

  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p>© 2026 DivorceU.AE · خدمة إحالة قانونية. ليست مكتب محاماة. المعلومات المقدمة للإرشاد فقط ولا تشكل استشارة قانونية.</p>
      <nav aria-label="تنقل التذييل">
        <a href="/ar/سياسة-الخصوصية/">سياسة الخصوصية</a>
        <a href="/ar/إخلاء-المسؤولية/">إخلاء المسؤولية</a>
        <a href="/en/">English</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .hero {
    background: linear-gradient(rgba(10,22,40,0.70), rgba(10,22,40,0.70)),
                url('/images/hero-dubai-office.webp') center/cover no-repeat;
    color: #fff; padding: 80px 0 60px;
  }
  .hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
  .hero__h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; line-height: 1.3; margin-bottom: 16px; }
  .hero__sub { font-size: 1.05rem; opacity: 0.9; margin-bottom: 24px; line-height: 1.9; }
  .hero__trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 0.9rem; }
  .hero__trust li { opacity: 0.9; }
  .section { padding: 60px 0; border-bottom: 1px solid #f3f4f6; }
  .section h2 { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 700; color: #1e3a5f; margin-bottom: 20px; }
  .section p { color: #374151; line-height: 2; margin-bottom: 16px; }
  .section--cta { border-bottom: none; background: #f0f4ff; border-radius: 16px; padding: 60px 40px; margin-bottom: 60px; text-align: center; }
  .steps { list-style: none; counter-reset: steps; display: flex; flex-direction: column; gap: 24px; margin-top: 24px; }
  .steps li {
    counter-increment: steps;
    padding: 24px 72px 24px 24px;
    position: relative;
    background: #f8faff;
    border-radius: 12px;
    border-right: 4px solid #2563eb;
  }
  .steps li::after {
    content: counter(steps);
    position: absolute; right: 20px; top: 24px;
    width: 36px; height: 36px;
    background: #2563eb; color: #fff;
    border-radius: 50%; display: flex;
    align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem;
  }
  .steps li h3 { font-size: 1rem; font-weight: 700; color: #1e3a5f; margin-bottom: 6px; }
  .steps li p { font-size: 0.9rem; color: #374151; margin: 0; }
  .footer { background: #1e3a5f; color: rgba(255,255,255,0.7); padding: 40px 0; }
  .footer__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  .footer p { font-size: 0.85rem; margin: 0; }
  .footer nav { display: flex; gap: 20px; }
  .footer nav a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.85rem; }
  .footer nav a:hover { color: #fff; }
  .main-content { padding-top: 20px; }
  @media (max-width: 768px) {
    .hero__inner { grid-template-columns: 1fr; gap: 40px; }
    .hero { padding: 50px 0 40px; }
    .section--cta { padding: 40px 24px; }
  }
  .guide-links { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .guide-links li { line-height: 1.8; }
  .guide-links a { color: #2563eb; font-weight: 600; text-decoration: underline; }
</style>
