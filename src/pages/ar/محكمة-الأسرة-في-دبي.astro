---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'محكمة الأحوال الشخصية في دبي: الموقع والمواعيد ورفع الدعوى';
const description =
  'محكمة الأحوال الشخصية في دبي (محكمة الأسرة): العنوان في القرهود ورقم مكاني، مواعيد العمل، أرقام التواصل، الرسوم، وخطوات رفع دعوى الطلاق والنفقة والحضانة.';

const canonical = 'https://divorceu.ae/ar/محكمة-الأسرة-في-دبي/';

const hreflang = {
  en: 'https://divorceu.ae/en/family-court-dubai/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'محكمة الأحوال الشخصية في دبي' },
];

const faqItems = [
  {
    question: 'أين تقع محكمة الأحوال الشخصية في دبي؟',
    answer: 'وفق صفحة التواصل الرسمية لمحاكم دبي تقع محكمة الأحوال الشخصية، ومعها محكمة التركات، في <strong>ديرة، منطقة القرهود، الشارع ٥، بجوار المبنى الرئيسي لهيئة الطرق والمواصلات</strong>، ورقم مكاني ٣٤٢٧٤٩١٩٥٢. وهي ليست في المبنى الرئيسي لمحاكم دبي (بر دبي، أم هرير ٢، شارع الرياض، بجوار جسر آل مكتوم). وتُدرج صفحة التواصل محكمة العمل ومحكمة التنفيذ في العوير (رقم مكاني ٤٩١٤٤٨٢٤٣٠)، فاسأل في محكمة الأحوال الشخصية عن الجهة التي تتولى تنفيذ حكم أسري كحكم النفقة.',
  },
  {
    question: 'ما مواعيد عمل محكمة الأحوال الشخصية في دبي؟',
    answer: 'من الاثنين إلى الخميس من <strong>٨:٠٠ صباحاً حتى ٣:٠٠ عصراً</strong>، ويوم الجمعة من ٨:٠٠ صباحاً حتى ١١:٣٠ صباحاً، وتغلق المحاكم في عطلة نهاية الأسبوع والعطلات الرسمية. أما مراكز العضيد التي تقبل طلبات المحاكم فتعمل من الاثنين إلى الخميس من ٨:٠٠ صباحاً حتى ٧:٣٠ مساءً، والجمعة من ٨:٠٠ صباحاً حتى ١٢:٠٠ ظهراً، وفي رمضان من الاثنين إلى الخميس من ٨:٠٠ صباحاً حتى ٤:٠٠ عصراً. قد تتغير المواعيد في رمضان والعطلات، فتحقّق منها قبل الذهاب.',
  },
  {
    question: 'ما رقم هاتف محكمة الأحوال الشخصية في دبي وكيف أتواصل معها؟',
    answer: 'مركز الاتصال لمحاكم دبي وواتساب على الرقم نفسه: <strong><span dir="ltr">+٩٧١ ٤ ٣٣٤ ٧٧٧٧</span></strong>، والبريد الإلكتروني info@dc.gov.ae، وتتوفر المحادثة الفورية على موقع محاكم دبي. ورقم مراكز العضيد للخدمات الحكومية ٦٠٠٥٢٣٤٣٣، ومن مراكزها البرشاء والقصيص والراشدية وعود ميثاء وأم هرير. هذا الموقع خدمة معلومات وترشيح مستقلة، وليس تابعاً لمحاكم دبي.',
  },
  {
    question: 'كم تستغرق قضية الطلاق في محكمة دبي؟',
    answer: 'لا يحدد القانون مدة إجمالية لقضية الطلاق، فهي تتوقف على اتفاق الطرفين أو نزاعهما، وعلى مرحلة التوفيق الأسري، وسرعة إعلان الطرف الآخر (خاصة إن كان خارج الدولة)، وتعيين الحكمين أو الخبراء. أما المواعيد التي يحددها القانون فمنها: ١٠ أيام عمل لتقديم المدعى عليه دفاعه من تاريخ إعلانه (المادة ٤٨(٢) من قانون الإجراءات المدنية)، و٦٠ يوماً كحد أقصى لعمل الحكمين من تعيينهما، و٣٠ يوماً للاستئناف (المادتان ٧٢ و٩ من المرسوم بقانون ٤١ لسنة ٢٠٢٤). وفي الطلاق المدني لغير المسلمين يجوز الحكم من الجلسة الأولى. للتفصيل راجع <a href="/ar/مدة-الطلاق-في-الامارات/">كم يستغرق الطلاق في الإمارات</a>.',
  },
  {
    question: 'هل يجب المرور بالتوجيه الأسري قبل رفع دعوى الطلاق في دبي؟',
    answer: 'بموجب المادة ٨ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ <strong>يجوز</strong> للقاضي المشرف إحالة الطرفين إلى التوجيه الأسري إذا رأى الصلح ممكناً، فالإحالة تقديرية وليست في كل قضية، ودعاوى إثبات الطلاق والمسائل المستعجلة والوقتية مستثناة منها. وتذكر صفحة خدمة «دعاوى الأحوال الشخصية» لدى محاكم دبي قرار الإحالة من التوفيق الأسري ضمن المستندات، فاسأل عند التسجيل عمّا ينطبق على ملفك. ولا تُحال دعاوى الطلاق المدني لغير المسلمين إلى التوجيه الأسري أصلاً (المادة ٣ من المرسوم بقانون ٤١ لسنة ٢٠٢٢).',
  },
  {
    question: 'هل أحتاج إلى محامٍ أمام محكمة الأحوال الشخصية في دبي؟',
    answer: 'لا يشترط القانون توكيل محامٍ: يحضر الخصوم بأنفسهم أو بوكيل من المحامين أو من الأقارب والأصهار حتى الدرجة الرابعة (المادة ٥٢(١) من المرسوم بقانون اتحادي رقم ٤٢ لسنة ٢٠٢٢). وإذا وكّلت محامياً فلا يمثّلك أمام المحكمة إلا محامٍ مرخّص مقيد في جدول المحامين المشتغلين (المادة ٦ من المرسوم بقانون اتحادي رقم ٣٤ لسنة ٢٠٢٢)، وفي دبي تقيد دائرة الشؤون القانونية لحكومة دبي المحامين في جداولها. يفيد المحامي خاصة في القضايا المتنازع عليها أو التي تشمل الحضانة والأموال.',
  },
  {
    question: 'هل يمكن رفع دعوى الطلاق إلكترونياً في دبي؟',
    answer: 'نعم. تذكر صفحة خدمة «دعاوى الأحوال الشخصية» قناتين للتقديم: موقع محاكم دبي ومراكز العضيد، وتُرفع صحيفة الدعوى والمستندات بصيغة PDF مع ترجمة قانونية إلى العربية، ويصدر الحكم الابتدائي إلكترونياً. ويسجّل الأفراد الدخول إلى الخدمات الإلكترونية عادةً بالهوية الرقمية UAE PASS، فتأكد من ذلك على الموقع. ويجيز قانون الإجراءات المدنية اتخاذ الإجراءات عن بُعد كلياً أو جزئياً، ولأي طرف أن يطلب في كل جلسة نظر الدعوى حضورياً والمحكمة تقرر (المادتان ٣٣٠ و٣٣٣).',
  },
  {
    question: 'كم رسوم دعوى الأحوال الشخصية في محاكم دبي؟',
    answer: 'وفق قانون دبي رقم ٢١ لسنة ٢٠١٥ بشأن الرسوم القضائية في محاكم دبي: <strong>١٠٠ درهم لكل طلب بحد أقصى ٢٠٠٠ درهم</strong>، و١٠٠ درهم للاستئناف (واستئناف أحكام النفقة بلا رسم)، و٢٠٠٠ درهم للطعن بالتمييز، و١٠٠ درهم لطلب منع السفر أو الأمر على عريضة، و٥٠ درهماً لفتح ملف التنفيذ. وخدمة التوفيق الأسري بلا رسم. تأكد من الرسم الحالي عند التسجيل. أما أتعاب المحامي والترجمة فتختلف من قضية إلى أخرى. راجع <a href="/ar/تكلفة-الطلاق-في-الامارات/">تكلفة الطلاق في الإمارات</a>.',
  },
  {
    question: 'ما الوثائق المطلوبة أمام محكمة الأحوال الشخصية في دبي؟',
    answer: 'صحيفة الدعوى، وقرار الإحالة من التوفيق الأسري حين ينطبق، وعقد الزواج، وهويات الطرفين وما يثبت أن أحدهما مواطن أو مقيم في دبي، وشهادات ميلاد الأطفال في دعاوى الحضانة والنفقة، وما يثبت الدخل في طلبات النفقة. تُرفع المستندات بصيغة PDF مع <strong>ترجمة قانونية إلى العربية</strong>، والوثائق الأجنبية تُصدَّق من وزارة خارجية بلد الإصدار ثم سفارة الإمارات هناك ثم وزارة الخارجية الإماراتية.',
  },
  {
    question: 'هل تنظر محكمة الأحوال الشخصية في دبي قضايا غير المسلمين؟',
    answer: 'نعم. يتقدم غير المسلمين المقيمون في دبي بدعاوى الطلاق إلى محكمة الأحوال الشخصية وفق <strong>المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢</strong> في شأن الأحوال الشخصية المدني، ما لم يتمسك أحد الزوجين بتطبيق قانون بلده (المادة ١). يكفي فيه طلب أحد الزوجين دون إثبات ضرر، ولا تُحال الدعوى إلى التوجيه الأسري، والحضانة المشتركة حق متساوٍ للوالدين حتى بلوغ الطفل ١٨ سنة. ولا قسمة تلقائية للأموال بالمناصفة. ولا تنظر محاكم مركز دبي المالي العالمي دعاوى الطلاق.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
  lastmod="2026-11-13"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">محكمة الأسرة في دبي · محكمة الأحوال الشخصية</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        حين يبحث الناس عن "محكمة الأسرة في دبي" يقصدون <strong>محكمة الأحوال الشخصية</strong> التابعة لمحاكم دبي. تجد هنا عنوانها الصحيح في القرهود ومواعيد عملها وأرقام التواصل الرسمية، ثم خطوات رفع الدعوى والرسوم والمستندات، وما يختلف بين المسلمين وغير المسلمين.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae · آخر تحديث نوفمبر ٢٠٢٦</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="answer-box">
        <h2>أين تقع محكمة الأحوال الشخصية في دبي؟</h2>
        <p class="answer-lead">
          تقع محكمة الأحوال الشخصية في دبي، ومعها محكمة التركات، في <strong>ديرة، منطقة القرهود، الشارع ٥، بجوار المبنى الرئيسي لهيئة الطرق والمواصلات</strong> (رقم مكاني ٣٤٢٧٤٩١٩٥٢). تعمل من الاثنين إلى الخميس من ٨:٠٠ صباحاً حتى ٣:٠٠ عصراً، ويوم الجمعة من ٨:٠٠ صباحاً حتى ١١:٣٠ صباحاً.
        </p>
        <div class="summary-grid">
          <div class="summary-item"><span class="label">العنوان</span><span class="value">ديرة، القرهود، الشارع ٥، بجوار المبنى الرئيسي لهيئة الطرق والمواصلات</span></div>
          <div class="summary-item"><span class="label">رقم مكاني</span><span class="value">٣٤٢٧٤٩١٩٥٢</span></div>
          <div class="summary-item"><span class="label">ساعات العمل</span><span class="value">الاثنين إلى الخميس ٨:٠٠ صباحاً حتى ٣:٠٠ عصراً، الجمعة ٨:٠٠ صباحاً حتى ١١:٣٠ صباحاً</span></div>
          <div class="summary-item"><span class="label">مركز الاتصال وواتساب</span><span class="value"><span dir="ltr">+٩٧١ ٤ ٣٣٤ ٧٧٧٧</span></span></div>
          <div class="summary-item"><span class="label">البريد الإلكتروني</span><span class="value">info@dc.gov.ae</span></div>
          <div class="summary-item"><span class="label">مراكز العضيد</span><span class="value">٦٠٠٥٢٣٤٣٣</span></div>
          <div class="summary-item"><span class="label">رسوم دعوى الأحوال الشخصية</span><span class="value">١٠٠ درهم للطلب، بحد أقصى ٢٠٠٠ درهم</span></div>
        </div>
        <p class="answer-note">
          قد تجد في مصادر قديمة أن المحكمة في <strong>المبنى الرئيسي لمحاكم دبي</strong>، وهو في بر دبي، أم هرير ٢، شارع الرياض، بجوار جسر آل مكتوم (رقم مكاني ٣٠٨٩٩٩٣٤٦٥). لكن صفحة التواصل الرسمية لمحاكم دبي (آخر تحديث لها فبراير ٢٠٢٦) تضع محكمة الأحوال الشخصية في القرهود. وتُدرج صفحة التواصل <strong>محكمة العمل ومحكمة التنفيذ في العوير</strong> (رقم مكاني ٤٩١٤٤٨٢٤٣٠)؛ اسأل عند التسجيل عن الجهة التي تتولى تنفيذ حكم أسري كحكم النفقة، وانظر <a href="/ar/تنفيذ-حكم-النفقة-الامارات/">تنفيذ حكم النفقة في الإمارات</a>. وتسري المواعيد نفسها على المبنى الرئيسي ومحكمة التنفيذ، وتغلق المحاكم في عطلة نهاية الأسبوع والعطلات الرسمية. وقد تتغير المواعيد في رمضان والأعياد، فاتصل بمركز الاتصال أو راجع موقع محاكم دبي قبل الذهاب.
        </p>
      </div>

      <section class="content-section">
        <h2>"محكمة الأسرة" في دبي هي محكمة الأحوال الشخصية</h2>
        <p>
          لا تحمل المحكمة في دبي اسم "محكمة الأسرة"، فاسمها الرسمي <strong>محكمة الأحوال الشخصية</strong> وهي جزء من محاكم دبي. تنظر هذه المحكمة قضايا الطلاق والخلع وفسخ الزواج والنفقة والحضانة والزيارة والمهر، وتوثيق الطلاق وإثباته، وتشاركها المبنى في القرهود محكمة التركات.
        </p>
        <p>
          تطبق المحكمة مسارين قانونيين: الأول <strong>المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤</strong> في شأن الأحوال الشخصية، الساري منذ ١٥ أبريل ٢٠٢٥، والثاني <strong>المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢</strong> في شأن الأحوال الشخصية المدني لغير المسلمين، الساري منذ ١ فبراير ٢٠٢٣. المبنى واحد، والقواعد مختلفة.
        </p>

        <h3>متى تكون محاكم دبي هي المختصة؟</h3>
        <p>
          تشترط صفحة خدمة "دعاوى الأحوال الشخصية" لدى محاكم دبي أن يكون أحد الطرفين مواطناً أو مقيماً في دبي. وتحدد المادة ٣ من المرسوم بقانون ٤١ لسنة ٢٠٢٤ الاختصاص المكاني: الأصل محكمة موطن المدعى عليه أو إقامته أو عمله، أما دعاوى الزوجة والأولاد والوالدين والحاضن في النفقة والحضانة والزيارة والمهر والطلاق والخلع والفسخ فيجوز رفعها أمام محكمة موطن المدعي أو المدعى عليه أو إقامته أو عمله أو محكمة بيت الزوجية.
        </p>
        <p>
          وإن كنت تقيم في إمارة أخرى فقد تكون المختصة محكمة إمارتك: لأبوظبي ورأس الخيمة محاكمهما المحلية، وللشارقة قضاؤها المحلي منذ ٢٠٢٥، وتنظر المحاكم الاتحادية قضايا عجمان والفجيرة وأم القيوين.
        </p>
      </section>

      <section class="content-section">
        <h2>درجات التقاضي في قضايا الأحوال الشخصية بدبي</h2>
        <p>
          تمر قضية الأحوال الشخصية في محاكم دبي بثلاث درجات، ولكل درجة ميعاد للطعن ورسم خاص.
        </p>
        <ol class="steps-list numbered">
          <li>
            <h3>محكمة الأحوال الشخصية الابتدائية</h3>
            <p>تُرفع فيها الدعوى وتسمع الطرفين وتفصل في الطلبات، وقد تقرر أثناء نظر دعوى النفقة نفقة مؤقتة للزوجة وأولادها (المادة ١٠٠ من المرسوم بقانون ٤١ لسنة ٢٠٢٤). ويصدر الحكم الابتدائي إلكترونياً وفق صفحة الخدمة لدى محاكم دبي.</p>
          </li>
          <li>
            <h3>محكمة الاستئناف</h3>
            <p>ميعاد الاستئناف في مسائل الأحوال الشخصية <strong>٣٠ يوماً</strong> (المادة ٩ من المرسوم بقانون ٤١ لسنة ٢٠٢٤)، يبدأ من اليوم التالي لصدور الحكم إن كان حضورياً، وإلا من اليوم التالي لإعلانه (المادة ١٠). رسم الاستئناف ١٠٠ درهم، واستئناف أحكام النفقة بلا رسم (قانون دبي رقم ٢١ لسنة ٢٠١٥).</p>
          </li>
          <li>
            <h3>محكمة التمييز</h3>
            <p>أعلى درجات التقاضي في محاكم دبي، وتراقب سلامة تطبيق القانون. ميعاد الطعن بالتمييز في مسائل الأحوال الشخصية ٣٠ يوماً كذلك (المادة ٩)، ورسمه ٢٠٠٠ درهم. أما شروط قبول الطعن في قضيتك فاسأل عنها محامياً مرخّصاً.</p>
          </li>
        </ol>
      </section>

      <section class="content-section">
        <h2>أي مسار يسري عليك؟ المسلمون وغير المسلمين</h2>

        <h3>للأزواج المسلمين</h3>
        <p>
          تخضع قضايا الأحوال الشخصية للمسلمين، مواطنين وأجانب، لأحكام <strong>المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤</strong>، مع مراعاة حق غير المواطن في التمسك بتطبيق قانونه وفق المادة ١. ومن أحكامه التي تخص هذه المحكمة مباشرة:
        </p>
        <ul>
          <li><strong>توثيق الطلاق:</strong> على الزوج توثيق الطلاق أمام المحكمة المختصة خلال ١٥ يوماً كحد أقصى من وقوعه، ولا يخل ذلك بحق الزوجة في رفع دعوى إثبات الطلاق. وإن لم يوثقه دون عذر تقبله المحكمة استحقت الزوجة تعويضاً يعادل النفقة من تاريخ الطلاق إلى تاريخ التوثيق (المادة ٥٨). فالتوثيق واجب يترتب على تركه تعويض، وليس شرطاً لوقوع الطلاق.</li>
          <li><strong>الحضانة:</strong> تكون بعد الفرقة للأم ثم الأب ثم من يليهما بالترتيب الوارد في المادة ١١٤، وللمحكمة الخروج عنه لمصلحة المحضون. وتنتهي الحضانة ببلوغ المحضون ١٨ سنة ميلادية (المادة ١٢٣)، وله عند بلوغ ١٥ سنة أن يختار من يقيم معه من أبويه ما لم تقتض مصلحته غير ذلك (المادة ١٢٢).</li>
          <li><strong>التوجيه الأسري:</strong> الإحالة إليه تقديرية بيد القاضي المشرف (المادة ٨)، وتفصيلها في القسم التالي.</li>
        </ul>

        <h3>لغير المسلمين بموجب المرسوم بقانون ٤١ لسنة ٢٠٢٢</h3>
        <p>
          يتقدم غير المسلمين في دبي بدعاوى طلاقهم إلى محكمة الأحوال الشخصية نفسها، لكن وفق مسار مدني مستقل. أبرز الفوارق:
        </p>
        <ul>
          <li><strong>طلاق دون إبداء أسباب:</strong> تكفي رغبة أحد الزوجين، دون حاجة إلى إثبات ضرر أو خطأ (المادتان ٧ و٨).</li>
          <li><strong>لا إحالة إلى التوجيه الأسري:</strong> تُعرض الدعوى مباشرة على المحكمة، ويجوز الحكم بالطلاق في الجلسة الأولى (المادة ٣).</li>
          <li><strong>لا قسمة تلقائية للأموال بالمناصفة:</strong> تُطلب النفقة بعد حكم الطلاق وتقدرها المحكمة وفق معايير منها مدة الزواج وسن الزوجة والوضع المالي للطرفين (المادة ٩). والتعويض عند عدم الاتفاق تقديري وفق المعايير الواردة في المادة ٦ من قرار مجلس الوزراء رقم ١٢٢ لسنة ٢٠٢٣، ومنها مدة الزواج والخطأ والضرر ومساهمة كل طرف في ثروة الآخر.</li>
          <li><strong>الحضانة المشتركة:</strong> حق مشترك ومتساوٍ للأب والأم بعد الطلاق (المادة ١٠) حتى بلوغ الطفل ١٨ سنة ثم يختار (المادة ٤). وإذا اختلف الوالدان على مسألة منها جاز لأي منهما أن يطلب من المحكمة الفصل فيها، والمحكمة تقضي بما يحقق مصلحة الطفل الفضلى.</li>
          <li><strong>حق كلا الزوجين في طلب الطلاق:</strong> لكل من الزوجين أن يطلب الطلاق بإرادته المنفردة (المادة ٤).</li>
        </ul>
        <p>
          يسري هذا المسار على غير المسلمين من المواطنين والأجانب المقيمين في الدولة، ما لم يتمسك أحد الزوجين بتطبيق قانون بلده الأصلي (المادة ١ من المرسوم بقانون ٤١ لسنة ٢٠٢٢). ويجوز للزوجين أيضاً الاتفاق على تطبيق تشريع آخر نافذ في الدولة ينظم مسائل الأسرة. وإذا كان أحد الزوجين مسلماً فالغالب أن يسري المرسوم بقانون ٤١ لسنة ٢٠٢٤، فاستشر محامياً في الحالات المختلطة.
        </p>

        <h3>ماذا عن محاكم مركز دبي المالي العالمي (DIFC)؟</h3>
        <p>
          يسأل كثير من غير المسلمين عن محاكم المركز لأنها تعمل بالإنجليزية. لكنها <strong>لا تختص بقضايا الأسرة</strong>، فلا تنظر الطلاق ولا الحضانة ولا النفقة، حتى لمن يعمل في المركز أو يملك شركة مسجلة فيه. تبقى محكمة الأحوال الشخصية هي الجهة المختصة بطلاق المقيمين في دبي. للتفاصيل راجع <a href="/ar/الطلاق-في-محكمة-دبي-المالية-الدولية/">دليل الطلاق ومحاكم DIFC</a>.
        </p>
      </section>

      <section class="content-section">
        <h2>التوجيه الأسري في دبي: متى يُحال الملف وما الذي يحدث</h2>
        <p>
          تنص المادة ٨ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ على أنه <strong>يجوز</strong> للقاضي المشرف، قبل إحالة الدعوى إلى المحكمة، أن يحيل الطرفين إلى التوجيه الأسري لتسوية النزاع ودياً إذا رأى ذلك ممكناً. فالإحالة تقديرية، ولا يحدد القانون مدة لهذه المرحلة.
        </p>

        <h3>خدمة التوفيق الأسري لدى محاكم دبي</h3>
        <p>
          تتيح محاكم دبي خدمة "التوفيق الأسري" (Family Conciliation) للمواطنين والمقيمين والعاملين في دبي. يُرفع فيها عقد الزواج بصيغة PDF، ولا رسم عليها، وتُقدَّم عبر موقع المحاكم بعد التسجيل المسبق أو عبر مراكز الخدمة الحكومية. وتنتهي بأحد أربعة أمور: صلح، أو تنازل، أو حفظ الملف، أو إحالة إلى المحكمة.
        </p>
        <p>
          وإذا تم الصلح أُثبت في محضر يوقّعه الطرفان والموجّه الأسري ويعتمده القاضي المشرف، فتكون له قوة السند التنفيذي، ولا يُطعن فيه إلا إذا خالف القانون (المادة ٨(٢)).
        </p>

        <h3>متى لا تُحال القضية إلى التوجيه الأسري؟</h3>
        <p>
          تستثني المادة ٨ من الإحالة:
        </p>
        <ul>
          <li>الوصايا والتركات.</li>
          <li>الدعاوى المستعجلة والوقتية، والأوامر المستعجلة والوقتية في النفقة والحضانة والولاية.</li>
          <li>الدعاوى التي لا يُتصوَّر فيها الصلح، مثل دعاوى إثبات الزواج وإثبات الطلاق.</li>
        </ul>
        <p>
          ولا تُحال دعاوى الطلاق المدني لغير المسلمين بموجب المرسوم بقانون ٤١ لسنة ٢٠٢٢ إلى التوجيه الأسري أصلاً (المادة ٣). وقد يُخلط بين هذه المرحلة ومدة الستين يوماً في المادة ٧٢، وهي مدة عمل <strong>الحكمين</strong> في دعاوى الشقاق المتنازع عليها من تاريخ تعيينهما، وتأتي بعد رفع الدعوى. فلا مدة محددة في القانون للتوجيه الأسري.
        </p>
      </section>

      <section class="content-section">
        <h2>رفع دعوى الطلاق في محكمة الأحوال الشخصية بدبي خطوة بخطوة</h2>
        <p>
          الخطوات التالية لدعوى تُنظر وفق المرسوم بقانون ٤١ لسنة ٢٠٢٤. في الطلاق المدني لغير المسلمين لا توجد مرحلة التوجيه الأسري. وللصورة على مستوى الدولة كلها راجع <a href="/ar/كيفية-تقديم-الطلاق-في-الامارات/">إجراءات الطلاق في الإمارات خطوة بخطوة</a>.
        </p>

        <div class="steps-list">
          <div class="step-card">
            <div class="step-num">٠١</div>
            <div class="step-body">
              <h3>التوفيق الأسري (إن أُحيل الملف إليه)</h3>
              <p>يُفتح الطلب عبر خدمة التوفيق الأسري على موقع محاكم دبي أو في مراكز الخدمة الحكومية، بلا رسم. إذا تعذّر الصلح أُحيل الملف إلى المحكمة. والإحالة تقديرية بموجب المادة ٨، وبعض الدعاوى مستثناة منها.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٢</div>
            <div class="step-body">
              <h3>تقديم صحيفة الدعوى</h3>
              <p>تُقدَّم عبر موقع محاكم دبي أو أحد مراكز العضيد. تذكر صفحة الخدمة رفع صحيفة الدعوى وقرار الإحالة من التوفيق الأسري، والمستندات بصيغة PDF مع ترجمة قانونية إلى العربية. ويجيز قانون الإجراءات المدنية رفع صحيفة الدعوى إلكترونياً أو ورقياً لدى مكتب إدارة الدعوى (المادة ٤٤(١))، والمدعي الذي ليس له موطن في الدولة يحدد موطناً مختاراً ووكيلاً قانونياً (المادة ٤٤(٢)(أ)).</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٣</div>
            <div class="step-body">
              <h3>سداد الرسوم</h3>
              <p>رسم دعوى الأحوال الشخصية <strong>١٠٠ درهم لكل طلب بحد أقصى ٢٠٠٠ درهم</strong> (قانون دبي رقم ٢١ لسنة ٢٠١٥ بشأن الرسوم القضائية في محاكم دبي). يجب سداد الرسم خلال ٣ أيام عمل تبدأ من اليوم التالي لإشعار السداد، وإلا عُدّ القيد كأن لم يكن (المادة ٤٧(١) من قانون الإجراءات المدنية). تأكد من الرسم الحالي عند التسجيل.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٤</div>
            <div class="step-body">
              <h3>إعلان الطرف الآخر</h3>
              <p>يجيز قانون الإجراءات المدنية إعلان المدعى عليه بمكالمة مسجلة صوتاً وصورة، أو رسالة نصية، أو التطبيقات الذكية، أو البريد الإلكتروني، أو الفاكس، أو غيرها من الوسائل الحديثة، أو تسليماً في محل الإقامة أو العمل أو الموطن المختار، فإن تعذّر ذلك فبالنشر على الموقع الإلكتروني للمحكمة (المادة ٩(١)(أ)). ويُعد الإعلان منتجاً لأثره من تاريخ الإرسال أو النشر (المادة ١١). وللمدعى عليه تقديم دفاعه خلال ١٠ أيام عمل من إعلانه (المادة ٤٨(٢)).</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٥</div>
            <div class="step-body">
              <h3>الجلسات والطلبات المؤقتة</h3>
              <p>قد تُعقد الجلسات حضورياً أو عن بُعد (المادة ٣٣١ من قانون الإجراءات المدنية)، ولأي طرف أن يطلب في كل جلسة نظر الدعوى حضورياً (المادة ٣٣٣). وفي دعوى النفقة يجوز للمحكمة، بطلب من الزوجة، أن تقرر نفقة مؤقتة لها ولأولادها تكون واجبة النفاذ بقوة القانون (المادة ١٠٠ من المرسوم بقانون ٤١ لسنة ٢٠٢٤). وتُطلب أوامر مثل منع السفر بأمر على عريضة، انظر <a href="/ar/أوامر-الطوارئ-الطلاق-الامارات/">أوامر الطوارئ في دعاوى الطلاق</a>.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٦</div>
            <div class="step-body">
              <h3>تقديم الأدلة والمستندات المالية</h3>
              <p>يقدّم كل طرف أدلته ومستنداته، ومنها ما يثبت الدخل في طلبات النفقة، إذ تُقدَّر النفقة بحسب سعة المنفق وحال المنفق عليه والوضع الاقتصادي زماناً ومكاناً (المادة ٩٦ من قانون الأحوال الشخصية). وفي دعاوى الشقاق المتنازع عليها قد تعيّن المحكمة حكمين، ولا تتجاوز مدة عملهما ٦٠ يوماً من تعيينهما (المادة ٧٢ من القانون نفسه).</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٧</div>
            <div class="step-body">
              <h3>صدور الحكم</h3>
              <p>يصدر الحكم الابتدائي إلكترونياً، ويشمل الطلاق وما طُلب معه من نفقة ومهر وحضانة. وفي الطلاق بحكم قضائي تبدأ العدة من تاريخ صيرورة الحكم نهائياً (المادة ٨٣ من قانون الأحوال الشخصية).</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٨</div>
            <div class="step-body">
              <h3>الطعن والتنفيذ</h3>
              <p>ميعاد الاستئناف <strong>٣٠ يوماً</strong>، يبدأ من اليوم التالي لصدور الحكم إن كان حضورياً، وإلا من اليوم التالي لإعلانه (المادتان ٩ و١٠ من قانون الأحوال الشخصية). ويُنفَّذ الحكم عبر ملف تنفيذ رسم فتحه ٥٠ درهماً. إن امتنع الطرف الآخر عن الدفع راجع <a href="/ar/تنفيذ-حكم-النفقة-الامارات/">تنفيذ حكم النفقة في الإمارات</a>.</p>
            </div>
          </div>
        </div>
        <p>
          إن كانت قضيتك متنازعاً عليها أو تشمل الحضانة أو الأموال، يمكنك طلب ترشيح محامٍ مرخّص عبر صفحة <a href="/ar/محامي-طلاق-دبي/">محامي طلاق في دبي</a>. نحن خدمة معلومات وترشيح، ولسنا مكتب محاماة ولا جهة تابعة لمحاكم دبي.
        </p>
      </section>

