---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'هل تسقط حضانة الأم إذا تزوجت في القانون الإماراتي؟ المادة ١١٣';
const description =
  'هل تسقط حضانة الأم إذا تزوجت في الإمارات؟ لا تسقط تلقائياً: المادة ١١٣ تترك للمحكمة إبقاء الطفل معها لمصلحته. لمن تنتقل الحضانة، وحضانة البنت، وسن ١٥ و١٨.';

const canonical = 'https://divorceu.ae/ar/حضانة-الام-بعد-الزواج-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/custody-if-mother-remarries-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'حضانة الأم بعد الزواج في الإمارات' },
];

const steps = [
  {
    num: '١',
    title: 'اقرئي نص المادة ١١٣ كما هو',
    desc: 'تشترط المادة ١١٣ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ في الحاضنة ألا تكون متزوجة من رجل أجنبي عن المحضون، إلا إذا قررت المحكمة خلاف ذلك لمصلحته. الزواج إذاً سبب قد يُطلب على أساسه نقل الحضانة، لكن النقل لا يتم إلا بقرار من المحكمة.',
  },
  {
    num: '٢',
    title: 'اجمعي وقائع حياة الطفل اليومية',
    desc: 'معيار القرار هو مصلحة المحضون. لذلك يفيد أن تكون بين يديك وقائع موثقة عن حياة الطفل الفعلية: مدرسته وانتظامه فيها، ومن يرعاه يومياً، والمسكن الذي يعيش فيه، وعلاقته بالأسرة الجديدة. هذه وقائع تعرضينها على المحكمة، وتقديرها يعود إليها وحدها.',
  },
  {
    num: '٣',
    title: 'إذا طلب الأب الحضانة، ردّي في الدعوى',
    desc: 'طلب الأب أو من يليه في الترتيب يُنظر أمام المحكمة، ولا يُنفَّذ بمجرد تقديمه. والمادة ١١٤ تتيح للمحكمة أن تخرج عن ترتيب الحاضنين إذا اقتضت مصلحة الطفل ذلك، فالمسألة تُحسم بالأدلة وليس بالترتيب وحده.',
  },
  {
    num: '٤',
    title: 'استعادة الحضانة إذا زال السبب',
    desc: 'وفق المادة ١١٥، يجوز لمن سقطت حضانته أن يطلبها من جديد متى زال سبب السقوط. فإذا انتهى الزواج الجديد بطلاق أو وفاة، يمكن للأم أن تتقدم بطلب جديد، وتفصل فيه المحكمة وفق مصلحة الطفل.',
  },
];

const faqItems = [
  {
    question: 'هل تسقط حضانة الأم إذا تزوجت في القانون الإماراتي؟',
    answer: 'لا تسقط تلقائياً. تشترط المادة ١١٣ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ في الحاضنة ألا تكون متزوجة من رجل أجنبي عن المحضون، إلا إذا قررت المحكمة خلاف ذلك لمصلحة المحضون. فالزواج يفتح الباب أمام الأب أو من يليه في الترتيب ليطلب الحضانة من المحكمة، والمحكمة هي التي تقرر بعد النظر في مصلحة الطفل، وقد تُبقيه مع أمه. كل حالة تُقدَّر على ملابساتها.',
  },
  {
    question: 'إذا تزوجت الأم فلمن تكون الحضانة؟',
    answer: 'إذا قررت المحكمة نقل الحضانة من الأم، فالترتيب في المادة ١١٤ هو: الأب، ثم أم الأم، ثم أم الأب، ثم من تراه المحكمة. ويجوز للمحكمة أن تخرج عن هذا الترتيب إذا اقتضت مصلحة الطفل ذلك، فلا ينتقل الطفل إلى الأب بصورة آلية.',
  },
  {
    question: 'إذا تزوجت الأم المطلقة فلمن تكون حضانة البنت؟',
    answer: 'تنطبق القاعدة نفسها على البنت والولد: لا تنتقل الحضانة من الأم إلا بقرار من المحكمة، وقد تُبقي المحكمة البنت مع أمها لمصلحتها. وإذا انتقلت الحضانة إلى رجل كالأب، فيُشترط فيه بالنسبة للبنت أن يكون محرماً لها وأن تكون عنده امرأة صالحة للحضانة (المادة ١١٣). وإذا لم يتوافر ذلك، فالتالي في ترتيب المادة ١١٤ أم الأم ثم أم الأب.',
  },
  {
    question: 'هل تستعيد الأم الحضانة إذا طُلّقت من زوجها الجديد؟',
    answer: 'يجوز لها أن تطلبها. تنص المادة ١١٥ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ على أن من سقطت حضانته يمكنه أن يطلبها من جديد متى زال سبب السقوط. فإذا سقطت حضانة الأم بسبب زواجها ثم انتهى ذلك الزواج، تتقدم بطلب إلى المحكمة، والمحكمة تقدّر مصلحة الطفل من جديد قبل أن تقرر. الاستعادة ليست تلقائية.',
  },
  {
    question: 'هل يسقط حق الأب إذا سكت عن المطالبة بالحضانة؟',
    answer: 'من حالات سقوط الحضانة في المادة ١١٥ سكوت صاحب الحق عن المطالبة بها أكثر من سنة بعد علمه بسببها. فإذا علم الأب بزواج الأم وسكت أكثر من سنة، فقد يُحتجّ عليه بهذا السكوت إذا طالب بعد ذلك. ويتوقف الأمر على ما يثبت من تاريخ علمه.',
  },
  {
    question: 'هل يختار الطفل أحد والديه إذا تزوجت أمه؟',
    answer: 'نعم عند بلوغه ١٥ سنة. تنص المادة ١٢٢ على أن للطفل في هذه السن أن يختار من يقيم معه من والديه، ما لم تقتض مصلحته غير ذلك. وتنتهي الحضانة ببلوغ ١٨ سنة ميلادية بحسب المادة ١٢٣، وتستمر بعد ذلك إذا كان الولد من ذوي الإعاقة.',
  },
  {
    question: 'ماذا عن غير المسلمين في مسألة الزواج والحضانة؟',
    answer: 'في المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢ بشأن الأحوال الشخصية المدنية، الحضانة بعد الطلاق حق مشترك ومتساوٍ بين الوالدين (المادة ١٠)، ولا تذكر هذه المادة زواج أحدهما سبباً مستقلاً لإنهائها. من يريد تغيير الترتيب يطلب من المحكمة، والمحكمة تفصل وفق مصلحة الطفل الفضلى. أما لائحة محكمة أبوظبي للأسرة المدنية فتذكر زواج الطرف الآخر مرة أخرى ضمن حالات طلب الإبعاد عن الحضانة المشتركة (المادة ٣٣ من اللائحة).',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
  lastmod="2026-10-12"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} lang="ar" />
  </div>

  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">حضانة الأطفال · الإمارات ٢٠٢٦</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        لا تسقط حضانة الأم تلقائياً إذا تزوجت. يشترط البند (٤) من المادة ١١٣ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ في الحاضنة ألا تكون متزوجة من رجل أجنبي عن المحضون، إلا إذا قررت المحكمة خلاف ذلك لمصلحة المحضون. لذلك على الأب، أو من يليه في ترتيب الحضانة، أن يطلب نقلها من المحكمة، والمحكمة تفصل وفق مصلحة الطفل.
      </p>
      <p class="hero-author">بقلم <strong>أليكسي سوننين</strong> · مستشار قانوني ومغترب في الإمارات · divorceu.ae · آخر تحديث أكتوبر ٢٠٢٦</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <!-- Quick answer -->
      <div class="answer-box">
        <h2>هل تسقط حضانة الأم إذا تزوجت؟ الجواب المختصر</h2>
        <p>
          <strong>لا، ليس تلقائياً.</strong> زواج الحاضنة من رجل أجنبي عن المحضون يُخلّ بأحد شروط الحضانة في <strong>المادة ١١٣ من قانون الأحوال الشخصية الاتحادي رقم ٤١ لسنة ٢٠٢٤</strong>، لكن النص نفسه يسمح للمحكمة بأن تقرر خلاف ذلك لمصلحة المحضون. ولا تنتقل الحضانة إلا بطلب إلى المحكمة وقرار منها. فإذا نُقلت، فالترتيب بعد الأم هو الأب ثم أم الأم ثم أم الأب (<strong>المادة ١١٤</strong>)، وللمحكمة أن تخرج عنه لمصلحة الطفل. ومن سقطت حضانته يطلبها من جديد متى زال السبب (<strong>المادة ١١٥</strong>). وعند ١٥ سنة يختار الطفل مع أي والديه يقيم ما لم تقتض مصلحته غير ذلك (<strong>المادة ١٢٢</strong>)، وتنتهي الحضانة عند ١٨ سنة (<strong>المادة ١٢٣</strong>).
        </p>
      </div>

      <img
        src="/images/child-custody-uae.webp"
        alt="أم وطفلها في الإمارات: قواعد الحضانة بعد الزواج الجديد"
        width="900" height="507"
        loading="lazy" decoding="async"
        class="article-img"
      />

      <!-- The rule -->
      <section class="content-section">
        <h2>القاعدة: المادة ١١٣ واستثناء مصلحة المحضون</h2>
        <p>
          النص الحاكم للمسلمين هو <strong>المادة ١١٣ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ بشأن الأحوال الشخصية</strong>، الذي دخل حيز التنفيذ في ١٥ أبريل ٢٠٢٥ وحلّ محل قانون الأحوال الشخصية الاتحادي لسنة ٢٠٠٥.
        </p>
        <p>
          تعدّد المادة ١١٣ الشروط الواجب توافرها في الحاضن. ومن الشروط الخاصة بالحاضنة ألا تكون متزوجة من رجل أجنبي عن المحضون، إلا إذا قررت المحكمة خلاف ذلك لمصلحة المحضون. للنص شقّان: الأصل أن زواج الحاضنة من رجل ليس من أقارب الطفل يُخلّ بشرط من شروط الحضانة، والاستثناء أن للمحكمة أن تُبقي الطفل مع أمه رغم ذلك إذا كانت مصلحته تقتضي ذلك.
        </p>
        <p>
          ويترتب على هذه الصياغة أمران. الأول أن القيد لا يتناول بنصّه زواج الأم من رجل غير أجنبي عن المحضون (من أقاربه). والثاني أن الزواج من رجل أجنبي عن المحضون لا ينقل الحضانة بذاته، بل يجعلها قابلة للطلب أمام المحكمة. وللإطار الأوسع، طالعي دليلنا عن <a href="/ar/حضانة-الاطفال-الامارات/">حضانة الأطفال في الإمارات</a>.
        </p>
      </section>

      <!-- Why not automatic -->
      <section class="content-section">
        <h2>لماذا لا تسقط الحضانة تلقائياً بزواج الأم</h2>
        <p>
          لا تنتقل الحضانة بمجرد توقيع الأم عقد زواج جديد. لا بد أن يطلب صاحب مصلحة نقل الحضانة من المحكمة، وهو عادة الأب أو من يليه في ترتيب المادة ١١٤. والمحكمة لا تقف عند واقعة الزواج وحدها، لأن النص يخوّلها أن تقرر خلاف الأصل لمصلحة المحضون.
        </p>
        <p>
          ومعنى ذلك عملياً أن السؤال أمام القاضي ليس: هل تزوجت الأم؟ بل: أين تتحقق مصلحة هذا الطفل تحديداً؟ وتختلف الإجابة من طفل لآخر، فقد تنتهي قضيتان متشابهتان في الظاهر إلى نتيجتين مختلفتين. لا يمكن لأحد أن يضمن النتيجة، وعلى الأم القلقة أن تطلب رأياً في حالتها من محامٍ مرخّص بدلاً من الاعتماد على قاعدة عامة.
        </p>
      </section>

      <!-- Custody order -->
      <section class="content-section">
        <h2>إذا تزوجت الأم لمن الحضانة؟ ترتيب المادة ١١٤</h2>
        <p>
          إذا قررت المحكمة نقل الحضانة من الأم، فالترتيب الذي تضعه <strong>المادة ١١٤ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤</strong> بعد الفرقة هو التالي:
        </p>
        <div class="compare-table">
          <div class="compare-header">
            <div>الترتيب</div>
            <div>الحاضن</div>
            <div>ملاحظة</div>
          </div>
          <div class="compare-row">
            <div class="compare-type">١</div>
            <div>الأم</div>
            <div>الأصل بعد الفرقة، بشرط توافر شروط المادة ١١٣</div>
          </div>
          <div class="compare-row alt">
            <div class="compare-type">٢</div>
            <div>الأب</div>
            <div>يُشترط فيه إذا كانت المحضونة بنتاً أن يكون محرماً لها وعنده امرأة صالحة للحضانة (المادة ١١٣)</div>
          </div>
          <div class="compare-row">
            <div class="compare-type">٣</div>
            <div>أم الأم</div>
            <div>تنطبق عليها شروط المادة ١١٣ نفسها</div>
          </div>
          <div class="compare-row alt">
            <div class="compare-type">٤</div>
            <div>أم الأب</div>
            <div>تنطبق عليها شروط المادة ١١٣ نفسها</div>
          </div>
          <div class="compare-row">
            <div class="compare-type">٥</div>
            <div>من تراه المحكمة</div>
            <div>إذا لم يتوافر حاضن مؤهل في الترتيب السابق</div>
          </div>
        </div>
        <p>
          ولهذا الترتيب قيدان. الأول أن المحكمة يجوز لها أن تخرج عنه لمصلحة الطفل، فلا ينتقل الطفل إلى الأب آلياً لمجرد أنه التالي في الترتيب. والثاني أن كل حاضن في الترتيب يجب أن تتوافر فيه شروط المادة ١١٣. وقد تُبقي المحكمة الطفل مع الأم وفق استثناء المادة ١١٣ نفسها. وعلى الآباء الباحثين عن مركزهم القانوني مطالعة صفحتنا عن <a href="/ar/حقوق-الوالدين-في-الحضانة-الامارات/">حقوق الوالدين في الحضانة بالإمارات</a>.
        </p>
      </section>

      <!-- Daughter -->
      <section class="content-section">
        <h2>إذا تزوجت الأم المطلقة فلمن تكون حضانة البنت؟</h2>
        <p>
          لا يختلف أثر زواج الأم بين البنت والولد. تبقى البنت مع أمها ما لم تقرر المحكمة غير ذلك، وللمحكمة أن تُبقيها معها رغم الزواج إذا اقتضت مصلحتها ذلك (المادة ١١٣).
        </p>
        <p>
          الفرق يظهر إذا انتقلت الحضانة إلى رجل. فبحسب البند (٥) من المادة ١١٣، يُشترط في الحاضن الرجل لبنت أن يكون محرماً لها، وأن تكون عنده امرأة صالحة للحضانة. الأب محرم لابنته بطبيعة الحال، لكن الشرط الثاني يتعلق بمن سيقوم على رعاية البنت في بيته.
        </p>
        <p>
          وإذا لم تتوافر الشروط في الأب، فالتالي في ترتيب المادة ١١٤ أم الأم ثم أم الأب، ويبقى للمحكمة أن تخرج عن الترتيب لمصلحة البنت. ولا يفرّق القانون بين البنت والولد في السن: للبنت أن تختار عند ١٥ سنة (المادة ١٢٢)، وتنتهي الحضانة عند ١٨ سنة ميلادية (المادة ١٢٣).
        </p>
      </section>

      <!-- Lapse and reclaim -->
      <section class="content-section">
        <h2>سقوط الحضانة واستعادتها (المادة ١١٥)</h2>
        <p>
          تعدّد <strong>المادة ١١٥ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤</strong> حالات سقوط الحضانة. أربع منها تهم الأم التي تزوجت أو تفكر في الزواج:
        </p>
        <div class="cost-grid">
          <div class="cost-card">
            <p class="cost-label">فقدان شرط</p>
            <p class="cost-amount">المادة ١١٣</p>
            <p class="cost-detail">فقدان شرط من شروط الحاضن سبب للسقوط، والزواج من رجل أجنبي عن المحضون أحدها، مع بقاء استثناء مصلحة المحضون</p>
          </div>
          <div class="cost-card">
            <p class="cost-label">السكوت</p>
            <p class="cost-amount">أكثر من سنة</p>
            <p class="cost-detail">سكوت صاحب الحق عن المطالبة بالحضانة أكثر من سنة بعد علمه بسببها</p>
          </div>
          <div class="cost-card">
            <p class="cost-label">الانتقال</p>
            <p class="cost-amount">بنية الإقامة</p>
            <p class="cost-detail">انتقال الحاضن إلى مكان بنية الإقامة لا تتحقق فيه مصالح المحضون</p>
          </div>
          <div class="cost-card">
            <p class="cost-label">الاستعادة</p>
            <p class="cost-amount">بزوال السبب</p>
            <p class="cost-detail">من سقطت حضانته يطلبها من جديد متى زال سبب السقوط</p>
          </div>
        </div>
        <p>
          <strong>السكوت أكثر من سنة.</strong> إذا علم الأب بزواج الأم وسكت عن المطالبة بالحضانة أكثر من سنة، فقد يُحتجّ عليه بهذا السكوت إذا طالب بعد ذلك. ويتوقف الأمر على ما يثبت من تاريخ علمه، فالأم التي تحتفظ بما يثبت متى علم الأب بزواجها تكون في موقف أوضح.
        </p>
        <p>
          <strong>الانتقال مع الزوج الجديد.</strong> قد يرافق الزواج الجديد انتقال إلى إمارة أو دولة أخرى. الانتقال بنية الإقامة إلى مكان لا تتحقق فيه مصالح الطفل حالة مستقلة من حالات السقوط، والسفر بالطفل خارج الدولة يحتاج إلى موافقة الطرف الآخر الكتابية أو إذن المحكمة (المادة ١١٦). التفاصيل في دليلنا عن <a href="/ar/انتقال-الطفل-بعد-الطلاق-في-الامارات/">انتقال الطفل بعد الطلاق في الإمارات</a>.
        </p>
        <p>
          <strong>الاستعادة بعد زوال السبب.</strong> يعامل القانون سقوط الحضانة على أنه قابل للعكس متى زال سببه. وأوضح مثال للأم هو انتهاء الزواج الجديد نفسه، بالطلاق أو بوفاة الزوج. فإذا كانت الحضانة قد سقطت بسبب ذلك الزواج، يمكن للأم أن تتقدم إلى محكمة الأحوال الشخصية بطلب استعادتها، والمحكمة تعيد تقدير مصلحة الطفل قبل أن تقرر. تغيير الحضانة المرتبط بالزواج ليس بالضرورة دائماً.
        </p>
      </section>

      <!-- Ages -->
      <section class="content-section">
        <h2>سن الحضانة: اختيار الطفل عند ١٥ وانتهاؤها عند ١٨</h2>
        <p>
          تنص <strong>المادة ١٢٢</strong> على أن للطفل عند بلوغه ١٥ سنة أن يختار من يقيم معه من والديه، ما لم تقتض مصلحته غير ذلك. فالولد أو البنت في هذه السن يستطيع أن يعبّر عن اختياره إذا تزوجت أمه، ويُعتدّ باختياره ما لم تر المحكمة أن مصلحته في غيره.
        </p>
        <p>
          وتنص <strong>المادة ١٢٣</strong> على أن الحضانة تنتهي ببلوغ ١٨ سنة ميلادية، وتستمر بعد ذلك إذا كان الولد من ذوي الإعاقة. وإذا قرأتِ أعماراً أقل لانتهاء الحضانة في مصادر قديمة، فهي من القانون السابق ولا تعبّر عن القانون الحالي.
        </p>
      </section>

      <!-- Conditions list -->
      <section class="content-section">
        <h2>شروط الحاضن في المادة ١١٣</h2>
        <p>
          قاعدة الزواج واحدة من عدة شروط في المادة ١١٣. فالحاضن، بصورة عامة، يجب أن يكون:
        </p>
        <div class="cost-grid">
          <div class="cost-card">
            <p class="cost-label">الأهلية</p>
            <p class="cost-amount">عاقل وبالغ</p>
            <p class="cost-detail">سليم العقل، وبالغاً ١٨ سنة على الأقل</p>
          </div>
          <div class="cost-card">
            <p class="cost-label">الأمانة والسلوك</p>
            <p class="cost-amount">أمين</p>
            <p class="cost-detail">أميناً على الطفل، وغير مدمن، ولم يُحكم عليه في جريمة من الجرائم الجنسية</p>
          </div>
          <div class="cost-card">
            <p class="cost-label">الصحة</p>
            <p class="cost-amount">خالٍ من مرض خطير</p>
            <p class="cost-detail">ألا يكون مصاباً بمرض خطير</p>
          </div>
          <div class="cost-card">
            <p class="cost-label">الدين والزواج</p>
            <p class="cost-amount">مشروط</p>
            <p class="cost-detail">متحداً مع الطفل في الدين إلا إذا كانت الحاضنة الأم وقررت المحكمة غير ذلك، وألا تكون الحاضنة متزوجة من رجل أجنبي عن المحضون إلا إذا قررت المحكمة خلاف ذلك لمصلحته</p>
          </div>
        </div>
        <p class="note-text">هذا ملخص مبسّط للمادة ١١٣ من قانون الأحوال الشخصية الاتحادي رقم ٤١ لسنة ٢٠٢٤، وليس بديلاً عن النص الرسمي أو الاستشارة القانونية. ويُشترط في الحاضن الرجل لبنت أن يكون محرماً لها وعنده امرأة صالحة للحضانة. ولمعرفة آثار الزواج الجديد على حقوق المرأة المالية، راجعي <a href="/ar/الزواج-بعد-الطلاق-في-الامارات/">الزواج بعد الطلاق في الإمارات</a>.</p>
      </section>

      <!-- Muslim vs non-Muslim -->
      <section class="content-section">
        <h2>غير المسلمين: القانون المدني الاتحادي ومحكمة أبوظبي للأسرة المدنية</h2>
        <p>
          قد يخضع المقيمون غير المسلمين لقانون مختلف هو <strong>المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢ بشأن الأحوال الشخصية المدنية</strong>، النافذ منذ ١ فبراير ٢٠٢٣، ما لم يتمسك أحد الطرفين بقانون بلده (المادة ١). وتجعل المادة ١٠ منه الحضانة بعد الطلاق حقاً مشتركاً ومتساوياً بين الأب والأم، وتمتد الحضانة المشتركة حتى ١٨ سنة ثم يختار الولد (المادة ٤).
        </p>
        <p>
          ولا تذكر المادة ١٠ زواج أحد الوالدين سبباً مستقلاً لإنهاء الحضانة المشتركة. تبقى الحضانة مشتركة ما لم يُطلب من المحكمة منحها لأحد الوالدين، أو يتنازل أحدهما كتابةً، أو يطلب أحدهما إبعاد الآخر لسبب تقبله المحكمة. وفي أي خلاف بين الوالدين يجوز لأيهما أن يلجأ إلى المحكمة على النموذج المخصص، والمحكمة تفصل وفق مصلحة الطفل الفضلى. فمن يرى أن الزواج الجديد يضر بالطفل عليه أن يقدم طلباً ويقنع المحكمة بالسبب.
        </p>
        <div class="compare-table">
          <div class="compare-header">
            <div>المسألة</div>
            <div>قانون الأحوال الشخصية للمسلمين (٤١/٢٠٢٤)</div>
            <div>القانون المدني لغير المسلمين (٤١/٢٠٢٢)</div>
          </div>
          <div class="compare-row">
            <div class="compare-type">الحضانة بعد الطلاق</div>
            <div>للأم أولاً، ثم ترتيب المادة ١١٤</div>
            <div>مشتركة ومتساوية بين الوالدين (المادة ١٠)</div>
          </div>
          <div class="compare-row alt">
            <div class="compare-type">أثر زواج الأم</div>
            <div>شرط في المادة ١١٣ مع استثناء مصلحة المحضون، ولا انتقال إلا بقرار المحكمة</div>
            <div>لا تذكره المادة ١٠ سبباً مستقلاً، والتغيير بطلب إلى المحكمة</div>
          </div>
          <div class="compare-row">
            <div class="compare-type">السن</div>
            <div>يختار الطفل عند ١٥، وتنتهي الحضانة عند ١٨ (المادتان ١٢٢ و١٢٣)</div>
            <div>مشتركة حتى ١٨ ثم يختار الولد (المادة ٤)</div>
          </div>
          <div class="compare-row alt">
            <div class="compare-type">النفقة</div>
            <div>نفقة العدة (المادة ١٠١) ونفقة الأطفال على الأب (المادة ١٠٦) مسألتان منفصلتان عن الحضانة</div>
            <div>نفقة المطلقة بعد حكم الطلاق بتقدير القاضي وفق معايير المادة ٩</div>
          </div>
        </div>

        <h3>أبوظبي: محكمة أبوظبي للأسرة المدنية</h3>
        <p>
          في إمارة أبوظبي تنظر محكمة أبوظبي للأسرة المدنية قضايا غير المسلمين وفق قانون أبوظبي رقم ١٤ لسنة ٢٠٢١ ولائحته الصادرة بقرار رئيس دائرة القضاء رقم ٨ لسنة ٢٠٢٢. وتنص المادة ٢٥ من اللائحة على أن للأم والأب حقاً متساوياً في الحضانة المشتركة حتى يبلغ الطفل ١٦ سنة، ثم يختار حاضنه. ويقضي حكم الطلاق بالحضانة المشتركة تلقائياً (المادة ٢٦ من اللائحة).
        </p>
        <p>
          وتذكر اللائحة صراحة زواج الطرف الآخر مرة أخرى ضمن الحالات التي تفصل فيها المحكمة في طلب إبعاد أحد الوالدين عن الحضانة المشتركة، مؤقتاً أو نهائياً (البند ٩ من المادة ٣٣). ويُقدَّم الطلب على النموذج المخصص (المادة ٣٢)، وللمحكمة أن تعلّق الترتيب مؤقتاً أو تكلّف خبيراً اجتماعياً بتقييم الاعتراضات. وتذكر المادة ٣٣ أيضاً رغبة الطفل متى بلغ ١٢ سنة ميلادية. أما النفقة، فتنص المادة ٨ من قانون أبوظبي رقم ١٤ لسنة ٢٠٢١ على سقوط نفقة المطلقة إذا تزوجت رجلاً آخر، وهي مسألة منفصلة عن الحضانة.
        </p>
        <p class="note-text">يتوقف القانون المُطبَّق على أطراف الدعوى والإمارة، فراجعي نظرتنا العامة على <a href="/ar/طلاق-غير-المسلمين-الامارات/">طلاق غير المسلمين في الإمارات</a> قبل افتراض انطباق نظام معيّن عليك.</p>
      </section>

