---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'كم مدة عدة الطلاق؟ المدة والأحكام والحقوق في القانون الإماراتي';
const description =
  'كم مدة عدة الطلاق في الإمارات؟ ثلاثة أطهار لمن تحيض، وثلاثة أشهر قمرية لمن لا تحيض، وحتى الولادة للحامل، ولا عدة قبل الدخول والخلوة. متى تبدأ، والنفقة والسكنى والرجعة.';

const hreflang = {
  en: 'https://divorceu.ae/en/iddah-waiting-period-uae/',
  ar: 'https://divorceu.ae/ar/عدة-الطلاق/',
};

const breadcrumbs = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'عدة الطلاق', url: 'https://divorceu.ae/ar/عدة-الطلاق/' },
];

const iddahTypes = [
  {
    type: 'المطلقة غير الحامل التي تحيض',
    duration: 'ثلاثة أطهار',
    basis: 'قوله تعالى: {وَالْمُطَلَّقَاتُ يَتَرَبَّصْنَ بِأَنفُسِهِنَّ ثَلَاثَةَ قُرُوءٍ} (البقرة: 228)',
    detail: 'اختلف الفقهاء في معنى القرء: هل هو الطهر أم الحيضة. والقانون الإماراتي حسم المسألة: عدة المطلقة غير الحامل التي تحيض ثلاثة أطهار (المادة 84). وتُحسب العدة بالأطهار لا بالأيام، فتختلف مدتها من امرأة لأخرى.',
  },
  {
    type: 'المطلقة الحامل',
    duration: 'حتى الولادة أو الإسقاط',
    basis: 'قوله تعالى: {وَأُولَاتُ الْأَحْمَالِ أَجَلُهُنَّ أَن يَضَعْنَ حَمْلَهُنَّ} (الطلاق: 4)',
    detail: 'تنتهي عدة الحامل بالولادة أو الإسقاط (المادة 85)، ولو وقع ذلك بعد الطلاق بأيام. وبعد الطلاق البائن تبقى للحامل نفقة العدة حتى الولادة (المادة 101).',
  },
  {
    type: 'المطلقة التي لا تحيض (سن اليأس أو لم تحض أصلاً)',
    duration: 'ثلاثة أشهر قمرية',
    basis: 'قوله تعالى: {وَاللَّائِي يَئِسْنَ مِنَ الْمَحِيضِ مِن نِّسَائِكُمْ إِنِ ارْتَبْتُمْ فَعِدَّتُهُنَّ ثَلَاثَةُ أَشْهُرٍ وَاللَّائِي لَمْ يَحِضْنَ} (الطلاق: 4)',
    detail: 'تشمل التي بلغت سن اليأس، والتي لم تحض أصلاً. وعدتها ثلاثة أشهر بالتقويم القمري (المادة 84).',
  },
  {
    type: 'المطلقة قبل الدخول وقبل الخلوة الصحيحة',
    duration: 'لا عدة عليها',
    basis: 'قوله تعالى: {يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَكَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِن قَبْلِ أَن تَمَسُّوهُنَّ فَمَا لَكُمْ عَلَيْهِنَّ مِنْ عِدَّةٍ} (الأحزاب: 49)',
    detail: 'لا تجب العدة في الفرقة بغير الوفاة إلا إذا وقعت بعد الدخول أو الخلوة الصحيحة في عقد صحيح (المادة 82). والخلوة في المادة 17 هي اجتماع الزوجين قبل الدخول في مكان يأمن فيه كل منهما من اطلاع الغير عليهما، وتثبت بإقرارهما أو بالشهود. فإذا ثبتت خلوة صحيحة وجبت العدة ولو لم يحصل دخول.',
  },
  {
    type: 'الأرملة (المتوفى عنها زوجها)',
    duration: 'أربعة أشهر وعشرة أيام',
    basis: 'قوله تعالى: {وَالَّذِينَ يُتَوَفَّوْنَ مِنكُمْ وَيَذَرُونَ أَزْوَاجًا يَتَرَبَّصْنَ بِأَنفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا} (البقرة: 234)',
    detail: 'هذه عدة الوفاة وليست عدة الطلاق، وتُذكر هنا للتمييز. تعتد الأرملة غير الحامل أربعة أشهر وعشرة أيام بالأشهر القمرية، سواء توفي زوجها قبل الدخول أو بعده (المادتان 82 و86). وإذا كانت حاملاً فعدتها حتى الولادة أو الإسقاط (المادة 85). والمعتدة من طلاق رجعي إذا توفي زوجها تنتقل إلى عدة الوفاة (المادة 86).',
  },
];

const rights = [
  { right: 'السكنى في جميع الحالات', detail: 'للمعتدة أن تسكن في بيت الزوجية مدة العدة، أو في مسكن مناسب إذا لم يكن بيت الزوجية مناسباً، وذلك في جميع الحالات (المادة 101). قال تعالى: {لَا تُخْرِجُوهُنَّ مِن بُيُوتِهِنَّ وَلَا يَخْرُجْنَ} (الطلاق: 1).' },
  { right: 'نفقة العدة بعد الطلاق الرجعي', detail: 'تجب نفقة العدة بعد الطلاق الرجعي (المادة 101). والنفقة في القانون تشمل الطعام والكسوة والمسكن والتطبيب والتعليم بحسب العرف (المادة 95)، وتُقدَّر بحسب سعة المنفق وحال المنفق عليها والوضع الاقتصادي زماناً ومكاناً (المادة 96).' },
  { right: 'بعد الطلاق البائن', detail: 'لا تجب نفقة العدة بعد الطلاق البائن إلا إذا كانت المطلقة حاملاً، فتجب لها حتى الولادة (المادة 101). ويبقى حقها في السكنى مدة العدة.' },
  { right: 'بعد الخلع والوفاة', detail: 'لا نفقة عدة بعد الخلع ولا بعد الوفاة (المادة 101)، ويبقى حق السكنى مدة العدة. فالمرأة التي تفكر في الخلع تحسب هذا الأثر قبل أن تقرر.' },
  { right: 'المتعة (التعويض) بعد الطلاق', detail: 'إذا طلّق الزوج زوجته المدخول بها في زواج صحيح بإرادته المنفردة، دون طلب منها أو سبب من جهتها، أو كانت الفرقة بسبب منه، استحقت متعة غير نفقة العدة، تُقدَّر بحسب حاله ولا تزيد على نفقة سنة لأمثالها، ويجوز تقسيطها، ويُراعى ما أصابها من ضرر (المادة 102).' },
];

const faqItems = [
  {
    question: 'كم مدة عدة الطلاق في القانون الإماراتي؟',
    answer:
      'تختلف بحسب حال المرأة. المطلقة غير الحامل التي تحيض عدتها ثلاثة أطهار، والتي بلغت سن اليأس أو لم تحض أصلاً عدتها ثلاثة أشهر قمرية (المادة 84 من المرسوم بقانون اتحادي رقم 41 لسنة 2024). والحامل عدتها حتى الولادة أو الإسقاط (المادة 85). ولا عدة على من طُلّقت قبل الدخول وقبل الخلوة الصحيحة (المادة 82). أما الأرملة غير الحامل فعدتها أربعة أشهر وعشرة أيام بالأشهر القمرية (المادة 86).',
  },
  {
    question: 'كم شهر عدة الطلاق؟',
    answer:
      'لا يوجد عدد ثابت من الأشهر لكل مطلقة. الأشهر الثلاثة القمرية هي عدة من بلغت سن اليأس أو لم تحض أصلاً (المادة 84). أما التي تحيض فعدتها ثلاثة أطهار، وقد تنتهي قبل ثلاثة أشهر أو بعدها بحسب دورتها. والحامل عدتها حتى الولادة أو الإسقاط مهما كان موعدها (المادة 85).',
  },
  {
    question: 'متى تبدأ عدة الطلاق؟',
    answer:
      'في الطلاق الذي تقضي به المحكمة تبدأ العدة من تاريخ صيرورة الحكم نهائياً. وإذا أُثبت الطلاق أمام المحكمة بالبينة أو بالإقرار، يُؤرَّخ الطلاق بتاريخ الإقرار ما لم يثبت تاريخ سابق (المادة 83). لذلك إذا وقع الطلاق ولم يُثبَت أمام المحكمة إلا بعد مدة، فقد تُحسب العدة من تاريخ الإقرار ما لم يثبت تاريخ الطلاق الفعلي.',
  },
  {
    question: 'هل يؤثر عدم توثيق الطلاق على العدة؟',
    answer:
      'على الزوج أن يوثّق الطلاق أمام المحكمة المختصة خلال 15 يوماً من وقوعه، ولا يمنع ذلك الزوجة من رفع دعوى لإثبات الطلاق. وإذا لم يوثّقه في الموعد دون عذر تقبله المحكمة، استحقت الزوجة تعويضاً يعادل النفقة من تاريخ الطلاق إلى تاريخ التوثيق (المادة 58). فالتوثيق واجب على الزوج، والمادة لا تجعله شرطاً لوقوع الطلاق. أما تاريخ الطلاق الذي تُحسب منه العدة عند الإثبات أمام المحكمة فتحدده المادة 83.',
  },
  {
    question: 'هل تجب النفقة أثناء العدة في الطلاق البائن؟',
    answer:
      'ليس دائماً. تجب نفقة العدة بعد الطلاق الرجعي. أما بعد الطلاق البائن فلا تجب إلا إذا كانت المطلقة حاملاً، فتستمر حتى الولادة. ولا نفقة عدة بعد الخلع ولا بعد الوفاة. وفي جميع الحالات لها أن تسكن في بيت الزوجية مدة العدة، أو في مسكن مناسب إذا لم يكن مناسباً (المادة 101).',
  },
  {
    question: 'هل على المختلعة عدة ونفقة عدة؟',
    answer:
      'عليها العدة إذا وقع الخلع بعد الدخول أو الخلوة الصحيحة، لأن الخلع يقع طلاقاً بائناً بينونة صغرى (المادة 65)، والعدة تجب في كل فرقة بغير الوفاة بعد الدخول أو الخلوة (المادة 82). لكن لا نفقة عدة لها بعد الخلع، ويبقى لها حق السكنى مدة العدة (المادة 101).',
  },
  {
    question: 'ما هي عدة الطلاق وما الحكمة منها؟',
    answer:
      'تعرّف المادة 81 من المرسوم بقانون اتحادي رقم 41 لسنة 2024 العدة بأنها المدة التي لا يجوز للمرأة خلالها أن تتزوج بسبب الفرقة. ومن حكمتها: استبراء الرحم والتأكد من عدم الحمل، وإعطاء فرصة للمراجعة إذا كان الطلاق رجعياً، وصون الأنساب.',
  },
  {
    question: 'هل يجوز للمطلقة الخروج من المنزل أثناء العدة؟',
    answer:
      'هذه مسألة فقهية في أصلها، وفي تفاصيل خروج المعتدة للعمل والحاجة خلاف بين الفقهاء بحسب نوع الطلاق والحاجة، فالأولى سؤال جهة إفتاء رسمية عن حالتك. أما القانون فيقرر للمعتدة حق السكنى في بيت الزوجية مدة العدة، أو في مسكن مناسب إذا لم يكن مناسباً (المادة 101).',
  },
  {
    question: 'هل يجوز الزواج من امرأة في عدة الطلاق؟',
    answer:
      'لا. تعدّ المادة 32 الزواج بامرأة في عدتها من رجل آخر من المحرمات المؤقتة، وتنص المادة 83 على أن المرأة لا تتزوج حتى تنقضي عدتها. والمطلقة رجعياً لا ينتهي عقد زواجها إلا بانقضاء العدة (المادة 59). ومن الناحية الشرعية لا يجوز التصريح بخطبة المعتدة.',
  },
  {
    question: 'ماذا يحدث لتأشيرة إقامة المرأة في الإمارات أثناء العدة؟',
    answer:
      'العدة وتأشيرة الإقامة أمران منفصلان: العدة حكم من أحكام الأحوال الشخصية، وانتهاؤها لا يمدد الإقامة ولا يُنهيها. إذا كانت إقامتك على كفالة زوجك، فاسألي الجهة المختصة بالإقامة عن وضعك بعد الطلاق وابدئي ترتيبه دون انتظار انتهاء العدة.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="ar"
  dir="rtl"
  hreflang={hreflang}
  lastmod="2026-10-12"
>
  <header class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <Breadcrumb items={breadcrumbs} lang="ar" />
        <h1 class="hero__h1">عدة الطلاق: كم مدتها وما أحكامها في القانون الإماراتي</h1>
        <p class="hero__sub">
          عدة المطلقة غير الحامل في القانون الإماراتي ثلاثة أطهار إن كانت تحيض، وثلاثة أشهر قمرية إن بلغت سن اليأس أو لم تحض أصلاً (المادة 84). وعدة الحامل تنتهي بالولادة أو الإسقاط (المادة 85)، ولا عدة على من طُلّقت قبل الدخول وقبل الخلوة الصحيحة (المادة 82).
        </p>
        <ul class="hero__trust">
          <li>✓ مدة العدة لكل حالة</li>
          <li>✓ النفقة والسكنى (المادة 101)</li>
          <li>✓ نصوص القانون الإماراتي</li>
          <li>✓ استشارة قانونية مجانية</li>
        </ul>
      </div>
      <div class="hero__form">
        <LeadForm lang="ar" variant="hero" heading="استشارة طلاق مجانية" />
      </div>
    </div>
  </header>

  <main class="container main-content">

    <!-- Answer first -->
    <section class="section" aria-labelledby="answer-heading">
      <h2 id="answer-heading">كم مدة عدة الطلاق؟</h2>
      <p>
        تحدد المواد 82 إلى 86 من المرسوم بقانون اتحادي رقم 41 لسنة 2024 بشأن الأحوال الشخصية مدة العدة بحسب حال المرأة، لا بعدد ثابت من الأيام. هذا ملخصها:
      </p>
      <div class="cost-table">
        <table>
          <thead>
            <tr>
              <th>الحالة</th>
              <th>مدة العدة</th>
              <th>المادة</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>مطلقة غير حامل تحيض</td><td>ثلاثة أطهار</td><td>84</td></tr>
            <tr><td>مطلقة غير حامل بلغت سن اليأس أو لم تحض أصلاً</td><td>ثلاثة أشهر قمرية</td><td>84</td></tr>
            <tr><td>مطلقة حامل</td><td>حتى الولادة أو الإسقاط</td><td>85</td></tr>
            <tr><td>مطلقة قبل الدخول وقبل الخلوة الصحيحة</td><td>لا عدة عليها</td><td>17 و82</td></tr>
            <tr><td>مختلعة بعد الدخول أو الخلوة</td><td>عدة المطلقة بحسب حالها</td><td>65 و82</td></tr>
            <tr><td>أرملة غير حامل</td><td>أربعة أشهر وعشرة أيام قمرية، قبل الدخول أو بعده</td><td>86</td></tr>
            <tr><td>أرملة حامل</td><td>حتى الولادة أو الإسقاط</td><td>85</td></tr>
            <tr><td>معتدة من طلاق رجعي توفي زوجها</td><td>تنتقل إلى عدة الوفاة</td><td>86</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        لا يوجد عدد أيام واحد لكل مطلقة. عدة التي تحيض تُحسب بالأطهار، فقد تنتهي قبل ثلاثة أشهر أو بعدها بحسب دورتها. والحامل تنتهي عدتها بالولادة مهما كان موعدها. وفي جميع الحالات لا يجوز للمرأة أن تتزوج قبل انقضاء عدتها (المادة 83).
      </p>
    </section>

    <!-- Intro -->
    <section class="section" aria-labelledby="intro-heading">
      <h2 id="intro-heading">ما هي العدة؟</h2>
      <p>
        العدة لغةً: المدة والحساب. واصطلاحاً: مدة انتظار مقدّرة شرعاً تلتزم بها المرأة بعد فراق زوجها طلاقاً أو وفاةً، لا يحلّ لها خلالها الزواج برجل آخر. وتعرّفها المادة 81 من المرسوم بقانون اتحادي رقم 41 لسنة 2024 بأنها المدة التي لا يجوز للمرأة خلالها أن تتزوج بسبب الفرقة.
      </p>
      <p>
        والحكمة من مشروعية العدة: استبراء الرحم ومعرفة براءته من الحمل، وإعطاء فرصة للمراجعة في الطلاق الرجعي، وصون الأنساب.
      </p>

      <div class="alert-box">
        <strong>تنبيه مهم:</strong> عدة الطلاق وعدة الوفاة مختلفتان. هذه الصفحة تتناول عدة الطلاق تحديداً. عدة الأرملة غير الحامل أربعة أشهر وعشرة أيام بالأشهر القمرية (المادة 86)، وعدة الحامل حتى الولادة أو الإسقاط (المادة 85).
      </div>
    </section>

    <!-- Iddah types -->
    <section class="section" aria-labelledby="types-heading">
      <h2 id="types-heading">مدة عدة الطلاق حسب حالة المرأة</h2>

      <div class="types-list">
        {iddahTypes.map((item, i) => (
          <div class="type-card">
            <div class="type-header">
              <div class="type-num">{i + 1}</div>
              <div class="type-info">
                <h3 class="type-name">{item.type}</h3>
                <span class="type-duration">{item.duration}</span>
              </div>
            </div>
            <p class="type-basis">{item.basis}</p>
            <p class="type-detail">{item.detail}</p>
          </div>
        ))}
      </div>

      <p style="margin-top: 24px;">
        وللحامل أحكام أخرى في النفقة والحضانة، فصّلناها في <a href="/ar/الطلاق-أثناء-الحمل-الامارات/">الطلاق أثناء الحمل في الإمارات</a>. أما المطلقة قبل الدخول وقبل الخلوة الصحيحة فلها نصف المهر المسمّى، فإن لم يُسمَّ مهر فلا يزيد ما تستحقه على نصف مهر المثل، والخلوة الصحيحة تؤكد المهر كاملاً (المادة 47). التفاصيل في <a href="/ar/المهر-عند-الطلاق-الامارات/">المهر عند الطلاق في الإمارات</a>.
      </p>
    </section>

    <!-- When it starts -->
    <section class="section" aria-labelledby="start-heading">
      <h2 id="start-heading">متى تبدأ عدة الطلاق؟</h2>
      <p>
        تنص المادة 83 على أن العدة في الطلاق الذي تقضي به المحكمة تبدأ من تاريخ صيرورة الحكم نهائياً. وإذا أُثبت الطلاق أمام المحكمة بالبينة أو بالإقرار، يُؤرَّخ الطلاق بتاريخ الإقرار، ما لم يثبت أنه وقع في تاريخ سابق.
      </p>
      <p>
        ولهذا أثر عملي. إذا تلفّظ الزوج بالطلاق ثم تأخر في إثباته أمام المحكمة، فقد تُحسب العدة من تاريخ إقراره لا من تاريخ التلفظ، إلا إذا ثبت التاريخ الأسبق. والقانون يُلزم الزوج بتوثيق الطلاق أمام المحكمة المختصة خلال 15 يوماً من وقوعه، دون أن يمنع ذلك الزوجة من رفع دعوى لإثبات الطلاق. وإذا لم يوثّقه في الموعد دون عذر تقبله المحكمة، استحقت الزوجة تعويضاً يعادل النفقة من تاريخ الطلاق إلى تاريخ التوثيق (المادة 58). التوثيق واجب على الزوج، والمادة لا تجعله شرطاً لوقوع الطلاق. وتفاصيل الإجراءات في <a href="/ar/قانون-الطلاق-في-الامارات/">قانون الطلاق في الإمارات</a>.
      </p>
    </section>

    <!-- Rights during iddah -->
    <section class="section" aria-labelledby="rights-heading">
      <h2 id="rights-heading">حقوق المرأة أثناء عدة الطلاق: النفقة والسكنى</h2>
      <p>
        القاعدة في المادة 101 من المرسوم بقانون اتحادي رقم 41 لسنة 2024 أن السكنى حق للمعتدة في جميع الحالات، أما نفقة العدة فتتوقف على نوع الطلاق:
      </p>

      <div class="rights-list">
        {rights.map((r, i) => (
          <div class="right-card">
            <div class="right-num">{i + 1}</div>
            <div class="right-content">
              <h3>{r.right}</h3>
              <p>{r.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <p style="margin-top: 24px;">
        وكيف تُطلب النفقة وتُقدَّر بعد الطلاق مشروح في <a href="/ar/نفقة-بعد-الطلاق-الامارات/">النفقة بعد الطلاق في الإمارات</a>، وأثر الخلع على حقوقك المالية في <a href="/ar/الخلع-في-الامارات/">الخلع في الإمارات</a>.
      </p>
    </section>

    <!-- Ruju -->
    <section class="section" aria-labelledby="ruju-heading">
      <h2 id="ruju-heading">مراجعة الزوجة أثناء العدة (الرجعة)</h2>
      <p>
        الطلاق الرجعي لا يُنهي عقد الزواج إلا بانقضاء العدة (المادة 59). وكل طلاق في زواج صحيح رجعي، إلا الطلقة الثالثة، والطلاق قبل الدخول أو الخلوة الذي تبين به المرأة بينونة صغرى (المادة 60). والخلع يقع طلاقاً بائناً بينونة صغرى (المادة 65)، فلا رجعة فيه. وللزوج في عدة الطلاق الرجعي أن يراجع زوجته، ولا يسقط هذا الحق بتنازله عنه (المادة 61).
      </p>

      <div class="qa-list">
        <div class="qa-card">
          <h3>كيف تتم المراجعة؟</h3>
          <p>بالفعل، أو بالقول الصريح، أو بالكتابة، فإن تعذّر ذلك فبالإشارة المفهومة. ولا تصح إلا منجزة، فلا تُعلَّق على شرط ولا تُضاف إلى المستقبل (المادة 62).</p>
        </div>
        <div class="qa-card">
          <h3>توثيق المراجعة وإبلاغ الزوجة</h3>
          <p>إذا كان الزوج قد وثّق الطلاق، فعليه أن يوثّق المراجعة أمام المحكمة المختصة خلال 15 يوماً منها، وأن يُعلم الزوجة بها فوراً ولو لم يكن الطلاق موثقاً (المادة 64).</p>
        </div>
        <div class="qa-card">
          <h3>إذا لم توثَّق المراجعة وتزوجت المرأة</h3>
          <p>إذا لم يوثّق الزوج المراجعة في الموعد، ولم تعلم بها المرأة فتزوجت غيره، تكون المراجعة غير صحيحة (المادة 64).</p>
        </div>
        <div class="qa-card">
          <h3>الخلاف على انقضاء العدة</h3>
          <p>لا يُقبل قول الزوجة في الطلاق والمراجعة إلا ببينة، لكن يُقبل قولها إن عدتها انقضت قبل المراجعة إذا كانت المدة مما تنقضي فيه العدة عادة (المادة 63).</p>
        </div>
        <div class="qa-card">
          <h3>بعد انقضاء العدة دون مراجعة</h3>
          <p>تصبح الطلقة الأولى أو الثانية بائنة بينونة صغرى، فلا تحل له إلا بعقد جديد ومهر جديد. أما الطلقة الثالثة فتقع بائنة بينونة كبرى من وقتها، ولا تحل له حتى تنقضي عدتها من زوج آخر دخل بها في زواج صحيح (المادة 59). والفرق بين الأنواع مفصّل في <a href="/ar/انواع-الطلاق/">أنواع الطلاق</a>.</p>
        </div>
      </div>
    </section>

    <!-- What is prohibited -->
    <section class="section" aria-labelledby="prohibited-heading">
      <h2 id="prohibited-heading">ما يحرم على المعتدة</h2>

      <div class="qa-list">
        <div class="qa-card">
          <h3>الزواج برجل آخر</h3>
          <p>لا يجوز للمعتدة أن تتزوج حتى تنقضي عدتها (المادة 83)، والزواج بامرأة في عدتها من رجل آخر من المحرمات المؤقتة في المادة 32. وهذا من أجلى حِكَم العدة: استبراء الرحم وصون الأنساب. وما بعد انقضاء العدة مشروح في <a href="/ar/الزواج-بعد-الطلاق-في-الامارات/">الزواج بعد الطلاق في الإمارات</a>.</p>
        </div>
        <div class="qa-card">
          <h3>الخروج من البيت</h3>
          <p>الأصل الشرعي ألا تُخرج المطلقة من بيتها ولا تخرج منه، وفي تفاصيل خروجها للعمل والحاجة خلاف بين الفقهاء بحسب نوع الطلاق والحاجة، فاسألي جهة إفتاء رسمية عن حالتك. أما القانون فيقرر لها حق السكنى في بيت الزوجية مدة العدة (المادة 101).</p>
        </div>
        <div class="qa-card">
          <h3>الإحداد (لعدة الوفاة)</h3>
          <p>الإحداد، أي ترك الزينة والطيب، حكم من أحكام عدة الوفاة. أما المطلقة رجعياً فهي في حكم الزوجة، وفي إحداد المطلقة طلاقاً بائناً خلاف بين الفقهاء.</p>
        </div>
      </div>
    </section>

    <!-- UAE law -->
    <section class="section" aria-labelledby="law-heading">
      <h2 id="law-heading">عدة الطلاق في القانون الإماراتي</h2>
      <p>
        ينظّم المرسوم بقانون اتحادي رقم 41 لسنة 2024 بشأن الأحوال الشخصية أحكام العدة، وهو ساري المفعول منذ 15 أبريل 2025 وقد حلّ محل القانون الاتحادي رقم 28 لسنة 2005 بشأن الأحوال الشخصية. وأحكام العدة فيه في المواد 81 إلى 86، وأحكام نفقة العدة في المادة 101.
      </p>

      <div class="alert-box">
        <strong>تنبيه مهم:</strong> العدة ونفقة العدة أمران مختلفان. العدة تجب بعد الدخول أو الخلوة الصحيحة مهما كان نوع الطلاق، أما نفقة العدة فتتوقف على نوعه (المادة 101). ويُحتسب الطلاق المتكرر أو المقترن بعدد، لفظاً أو كتابة أو إشارة، طلقةً واحدة (المادة 57).
      </div>

      <div class="steps">
        <div class="step-item">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>على من تُطبَّق هذه الأحكام؟</h3>
            <p>يسري القانون على المواطنين إذا كان الزوجان أو أحدهما مسلماً، وعلى غير المواطنين ما لم يتمسك أحدهم بتطبيق قانونه أو قانون آخر متفق عليه في الحدود المسموح بها (المادة 1). فالمسلمة الأجنبية التي يُطبَّق على طلاقها هذا القانون تعتد بالأحكام نفسها.</p>
          </div>
        </div>
        <div class="step-item">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>غير المسلمين</h3>
            <p>المرسوم بقانون اتحادي رقم 41 لسنة 2022 بشأن الأحوال الشخصية المدنية قانون مختلف لغير المسلمين، وأحكام العدة المشروحة هنا من قانون 2024. إذا كنتِ غير مسلمة، فتحققي مع محامٍ من القانون الذي يحكم طلاقك قبل أن تبني على قواعد العدة. وانظري <a href="/ar/طلاق-غير-المسلمين-الامارات/">طلاق غير المسلمين في الإمارات</a>.</p>
          </div>
        </div>
        <div class="step-item">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>الحساب بالأشهر القمرية</h3>
            <p>الأصل في حساب المدد في القانون التقويم الميلادي ما لم يُنص على غيره (المادة 2). وقد نصّ القانون على حساب عدة الأشهر للمطلقة التي لا تحيض، وعدة الوفاة، بالأشهر القمرية (المادتان 84 و86).</p>
          </div>
        </div>
        <div class="step-item">
          <div class="step-num">4</div>
          <div class="step-content">
            <h3>المرأة الأجنبية وتأشيرة الإقامة</h3>
            <p>العدة وتأشيرة الإقامة أمران منفصلان: انتهاء العدة لا يمدد الإقامة ولا يُنهيها. إذا كانت إقامتك على كفالة زوجك، فابدئي ترتيب وضعك بعد الطلاق دون انتظار انتهاء العدة، وتفاصيل المسارات في <a href="/ar/تأشيرة-بعد-الطلاق-الامارات/">التأشيرة بعد الطلاق في الإمارات</a>.</p>
          </div>
        </div>
      </div>
    </section>

